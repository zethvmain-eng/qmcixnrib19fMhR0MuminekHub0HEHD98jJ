local function GetCorrectScript()
    for gameName, config in pairs(GameRoutes) do
        for _, id in ipairs(config.Ids) do
            -- Sprawdzamy zarówno PlaceId (konkretna mapa) jak i GameId (całe uniwersum gry)
            if PlaceId == id or GameId == id then
                return config.Url, gameName
            end
        end
    end
    -- Jeśli pętla nic nie znalazła, zwraca wersję uniwersalną
    return UniversalScript, "Universal (MuminekHub)"
end
 
