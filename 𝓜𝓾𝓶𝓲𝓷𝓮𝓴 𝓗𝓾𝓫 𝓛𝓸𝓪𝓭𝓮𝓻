    task.wait(0.15)
    TweenService:Create(LoadingSpinner, TweenInfo.new(0.2), { ImageTransparency = 0 }):Play()
    
    task.wait(1.1)
    
    particleSpeedMultiplier = 7
    globalParticleColor = SuccessColor
    
    local centerPos = MainShadow.AbsolutePosition + (MainShadow.AbsoluteSize / 2)
    SpawnScreenBurst(centerPos, SuccessColor, 45) -- Eksplozja sukcesu na cały ekran
    
    TweenService:Create(LoadingSpinner, TweenInfo.new(0.15), { ImageTransparency = 1 }):Play()
    StatusLabel.TextColor3 = SuccessColor
    StatusLabel.Text = "Poprawny Klucz , zapraszamy"
    
    TweenService:Create(SubmitBtn, TweenInfo.new(0.3), { BackgroundColor3 = SuccessColor, BackgroundTransparency = 0 }):Play()
    TweenService:Create(LiquidGlow, TweenInfo.new(0.4), { ImageColor3 = SuccessColor, ImageTransparency = 0.2 }):Play()
    TweenService:Create(GlassStroke, TweenInfo.new(0.3), { Color = SuccessColor, Transparency = 0.4 }):Play()
    
    task.wait(0.8)
    
    scanlineTween:Cancel()
    TweenService:Create(LiquidGlow, TweenInfo.new(0.25), { ImageTransparency = 1 }):Play()
    
    local Collapse = TweenService:Create(MainShadow, TweenInfo.new(0.55, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 6)
    })
    Collapse:Play()
    
    local fade = TweenInfo.new(0.2)
    TweenService:Create(GlassFrame, fade, { BackgroundTransparency = 1 }):Play()
    TweenService:Create(Title, fade, { TextTransparency = 1 }):Play()
    TweenService:Create(KeyContainer, fade, { BackgroundTransparency = 1 }):Play()
    TweenService:Create(KC_Stroke, fade, { Transparency = 1 }):Play()
    TweenService:Create(KeyInput, fade, { TextTransparency = 1 }):Play()
    TweenService:Create(SubmitBtn, fade, { BackgroundTransparency = 1 }):Play()
    TweenService:Create(StatusLabel, fade, { TextTransparency = 1 }):Play()
    
    Collapse.Completed:Wait()
    glowConnection:Disconnect()
    LoaderGui:Destroy()
    task.spawn(scriptCallback)
end
 
