local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
local currentBasePosition = UDim2.new(0.5, 0, 0.5, 0)
 
GlassFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = currentBasePosition
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
 
GlassFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
 
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        currentBasePosition = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
 
-- Fizyka czasu rzeczywistego
local glowConnection
glowConnection = RunService.RenderStepped:Connect(function(delta)
    if LoaderGui and LiquidGlow.Parent then
        MainShadow.Position = MainShadow.Position:Lerp(currentBasePosition, 1 - math.exp(-15 * delta))
        LiquidGlow.Position = LiquidGlow.Position:Lerp(MainShadow.Position, 1 - math.exp(-10 * delta))
        LoadingSpinner.Rotation = (LoadingSpinner.Rotation + (200 * delta)) % 360
        
        -- Wewnętrzne cząsteczki
        for _, p in ipairs(particles) do
            p.Obj.BackgroundColor3 = p.Obj.BackgroundColor3:Lerp(globalParticleColor, 1 - math.exp(-10 * delta))
            local currentPos = p.Obj.Position
            local newX = currentPos.X.Scale + (p.XSpeed * delta * particleSpeedMultiplier) / MainShadow.AbsoluteSize.X
            local newY = currentPos.Y.Scale + (p.YSpeed * delta * particleSpeedMultiplier) / MainShadow.AbsoluteSize.Y
            
            if newY < 0 or newX < 0 or newX > 1 then
                newY = 1.05
                newX = math.random()
            end
            p.Obj.Position = UDim2.new(newX, 0, newY, 0)
        end
        
        -- Zewnętrzne cząsteczki wychodzące poza ekran
        for i = #screenParticles, 1, -1 do
            local p = screenParticles[i]
            p.Life = p.Life - (p.FadeSpeed * delta)
            if p.Life <= 0 then
                p.Obj:Destroy()
                table.remove(screenParticles, i)
            else
                p.Obj.BackgroundTransparency = 1 - p.Life
                p.Obj.Position = UDim2.fromOffset(
                    p.Obj.Position.X.Offset + (p.XSpeed * delta),
                    p.Obj.Position.Y.Offset + (p.YSpeed * delta)
                )
            end
        end
    else
        glowConnection:Disconnect()
    end
end)
 
