    -- Funkcja do obliczania poprawnej pozycji myszy (uwzględnia pasek Robloxa)
    local function GetMousePos()
        local pos = UIS:GetMouseLocation()
        local inset = GuiService:GetGuiInset()
        return Vector2.new(pos.X, pos.Y - inset.Y)
    end

    local function GetTarget()
        local target = nil
        local shortestDist = CursorSettings.Range
        local mousePos = UIS:GetMouseLocation() -- Centrujemy względem kursora

        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                -- Team Check
                if CursorSettings.TeamCheck and p.Team == LocalPlayer.Team then continue end
                
                -- Sprawdzenie czy żyje
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health <= 0 then continue end

                local head = p.Character.Head
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)

                if onScreen then
                    -- Obliczamy dystans od kursora do głowy na ekranie
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        target = screenPos
                    end
                end
            end
        end
        return target
    end

    -- Pętla z wymuszeniem priorytetu
    RunService.RenderStepped:Connect(function()
        if CursorSettings.Enabled then
            local target = GetTarget()
            
            if target then
