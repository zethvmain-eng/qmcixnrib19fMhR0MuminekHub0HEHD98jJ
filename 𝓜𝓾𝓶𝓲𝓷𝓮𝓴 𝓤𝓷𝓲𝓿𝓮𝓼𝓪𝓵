-- Funkcja szukająca celu (z FOV)
local function getSilentTarget(fov)
    local target = nil
    local shortestDist = math.huge
    local camera = workspace.CurrentCamera
    local localChar = LocalPlayer.Character
    if not localChar then return nil end
    local localHrp = localChar:FindFirstChild("HumanoidRootPart")
    if not localHrp then return nil end

    local lookVector = camera.CFrame.LookVector
    local fovRad = math.rad(fov / 2)

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            if head then
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local direction = (head.Position - camera.CFrame.Position).Unit
                    local angle = math.acos(lookVector:Dot(direction))
                    if angle <= fovRad then
                        local dist = (head.Position - localHrp.Position).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            target = player
                        end
                    end
                end
            end
        end
    end
    return target
end

-- Funkcja celowania (przestawia kamerę na cel)
local function aimAtTarget(target)
    if not target or not target.Character then return false end
    local head = target.Character:FindFirstChild("Head")
    if not head then return false end
    local cam = workspace.CurrentCamera
    if not cam then return false end
    cam.CFrame = CFrame.new(cam.CFrame.Position, head.Position)
    return true
end

-- Funkcja oddania strzału (VIM)
local function shoot()
    local VIM = game:GetService("VirtualInputManager")
    VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
