    do
        local settings = {
            enabled = false,
            fov = 30,
            smooth = 10,
            delay = 0.1,
            aimKey = Enum.UserInputType.MouseButton2,
            aimPart = "Head",
            maxDistance = 300,
            teamCheck = false,
            visibleCheck = true,
            drawFOV = true,
        }

        local UIS = game:GetService("UserInputService")
        local RunService = game:GetService("RunService")
        local Players = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer
        local Camera = workspace.CurrentCamera
        local aimConnection = nil
        local fovCircle = nil
        local isAiming = false

        -- Rysowanie koła FOV
        local function createFOVCircle()
            if fovCircle then return end
            fovCircle = Drawing.new("Circle")
            fovCircle.Thickness = 1.5
            fovCircle.NumSides = 64
            fovCircle.Color = Color3.fromRGB(0, 255, 255)
            fovCircle.Transparency = 0.5
            fovCircle.Filled = false
            fovCircle.Visible = false
        end
        createFOVCircle()

        -- Funkcja szukająca celu w FOV
        local function getTarget()
            local target = nil
            local shortestAngle = settings.fov
            local char = LocalPlayer.Character
            if not char then return nil end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return nil end

            for _, player in pairs(Players:GetPlayers()) do
                if player == LocalPlayer then continue end
                if settings.teamCheck and player.Team == LocalPlayer.Team then continue end
                local tChar = player.Character
                if not tChar then continue end
                local aimPart = tChar:FindFirstChild(settings.aimPart) or tChar:FindFirstChild("Head")
                if not aimPart then continue end
                local hum = tChar:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health <= 0 then continue end

                local dist = (aimPart.Position - hrp.Position).Magnitude
                if dist > settings.maxDistance then continue end

                -- Sprawdź kąt
                local direction = (aimPart.Position - Camera.CFrame.Position).Unit
                local angle = math.deg(math.acos(Camera.CFrame.LookVector:Dot(direction)))
                if angle > settings.fov then continue end

                -- Sprawdź widoczność (raycast)
                if settings.visibleCheck then
                    local params = RaycastParams.new()
                    params.FilterDescendantsInstances = {char, tChar}
                    params.FilterType = Enum.RaycastFilterType.Blacklist
                    local hit = workspace:Raycast(Camera.CFrame.Position, (aimPart.Position - Camera.CFrame.Position), params)
                    if hit then continue end
                end

                if angle < shortestAngle then
                    shortestAngle = angle
                    target = player
                end
            end
            return target
        end

        -- Główna pętla celu
        local function aimLoop()
            if not settings.enabled or not isAiming then return end
            local target = getTarget()
            if not target then return end
            local tChar = target.Character
            if not tChar then return end
            local aimPart = tChar:FindFirstChild(settings.aimPart) or tChar:FindFirstChild("Head")
            if not aimPart then return end

            -- Celowanie z smooth
            local targetCFrame = CFrame.new(Camera.CFrame.Position, aimPart.Position)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 1 / settings.smooth)

            -- Opóźnienie (delay) – symulacja reakcji
            -- W tym przypadku opóźnienie jest już wbudowane przez smooth,
            -- ale możemy dodać osobny timer, aby celowanie zaczynało się po czasie.
            -- Użyjemy task.wait w pętli (opóźnienie przed każdym ruchem)
        end

        -- Pętla z opóźnieniem
        local function startAiming()
            if aimConnection then return end
            isAiming = true
            aimConnection = RunService.RenderStepped:Connect(function()
                if not settings.enabled or not isAiming then
                    aimConnection:Disconnect()
                    aimConnection = nil
                    return
                end
                aimLoop()
            end)
        end

