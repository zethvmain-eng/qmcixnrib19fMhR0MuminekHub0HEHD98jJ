    -- Funkcja sprawdzająca NPC (zabezpieczenie)
    local function IsNPC(obj)
        return obj and obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and obj:FindFirstChild("HumanoidRootPart") and not Players:GetPlayerFromCharacter(obj)
    end

    -- Funkcja znajdująca cel
    local function getClosestNPC()
        local target = nil
        local shortestDist = math.huge
        local localChar = LocalPlayer.Character
        if not localChar then return nil end
        local localHrp = localChar:FindFirstChild("HumanoidRootPart")
        if not localHrp then return nil end
        local cam = Camera
        if not cam then return nil end

        local lookVector = cam.CFrame.LookVector
        local fovRad = math.rad(npcBotFOV / 2)

        for _, obj in pairs(workspace:GetDescendants()) do
            if IsNPC(obj) then
                local hrp = obj:FindFirstChild("HumanoidRootPart")
                local head = obj:FindFirstChild("Head")
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if not hrp or not head or not hum then continue end
                if hum.Health <= 0 then continue end

                local dist = (head.Position - localHrp.Position).Magnitude
                if dist > npcBotRange then continue end

                local direction = (head.Position - cam.CFrame.Position).Unit
                local angle = math.acos(lookVector:Dot(direction))
                if angle > fovRad then continue end

                -- Sprawdzenie widoczności
                local params = RaycastParams.new()
                params.FilterDescendantsInstances = {localChar, obj}
                params.FilterType = Enum.RaycastFilterType.Blacklist
                local rayResult = workspace:Raycast(cam.CFrame.Position, (head.Position - cam.CFrame.Position).Unit * dist, params)
                if rayResult then
                    local hitPart = rayResult.Instance
                    if hitPart and hitPart.Parent ~= obj then
                        continue
                    end
                end

                if dist < shortestDist then
                    shortestDist = dist
                    target = obj
                end
            end
        end
        return target
    end

