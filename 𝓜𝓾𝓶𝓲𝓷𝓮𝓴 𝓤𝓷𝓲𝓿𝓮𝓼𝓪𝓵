        })
        LegitOpt:AddLabel('Tylko widoczni'):AddToggle({
            Default = true,
            Flag = "LegitBot_Visible",
            Callback = function(v) settings.visibleCheck = v end
        })
        LegitOpt:AddLabel('Pokaż koło FOV'):AddToggle({
            Default = true,
            Flag = "LegitBot_DrawFOV",
            Callback = function(v)
                settings.drawFOV = v
                if fovCircle then fovCircle.Visible = v end
            end
        })

        -- Aktualizacja koła FOV przy zmianie rozmiaru ekranu
        local function updateFOVCircle()
            if not fovCircle then return end
            local cam = workspace.CurrentCamera
            if cam then
                local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
                fovCircle.Position = center
                fovCircle.Radius = (settings.fov / 180) * (cam.ViewportSize.Y / 2.5)
            end
        end
        RunService.RenderStepped:Connect(updateFOVCircle)
        updateFOVCircle()

        -- Czyszczenie
        LocalPlayer.CharacterAdded:Connect(function()
            if settings.enabled then
                stopAiming()
            end
        end)

        if DEBUG_MODE and Logging and Logging.new then
            Logging.new("eye", "Legit Bot załadowany", 5)
        end
    end

    if DEBUG_MODE and Logging and Logging.new then
        Logging.new("shield-lock", "Sekcja HVH załadowana", 5)
    end
end

