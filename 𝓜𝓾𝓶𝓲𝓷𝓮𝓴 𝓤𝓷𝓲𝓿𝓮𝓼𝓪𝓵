        Name = "Player", 
        Position = 'right',
        Icon = "person"
    })

    -- ----------------------------------------
    --  1. ANTI-AFK (ochrona przed wyrzuceniem)
    -- ----------------------------------------
    do
        local antiAfkEnabled = false
        local antiAfkThread = nil

        local AntiAfkLabel = PlayerSection:AddLabel('Anti-AFK')
        AntiAfkLabel:AddToggle({
            Default = false,
            Flag = "AntiAFK_Player",
            Callback = function(v)
                antiAfkEnabled = v
                if v then
                    if Logging and Logging.new then 
                        Logging.new("shield-lock", "Anti-AFK włączony – symuluję ruch myszką co 60s", 3) 
                    end
                    if not antiAfkThread then
                        antiAfkThread = task.spawn(function()
                            while antiAfkEnabled do
                                task.wait(60)
                                local UIS = game:GetService("UserInputService")
                                local VIM = game:GetService("VirtualInputManager")
                                local pos = UIS:GetMouseLocation()
                                VIM:SendMouseMoveEvent(pos.X + 2, pos.Y + 2, game)
                                task.wait(0.05)
                                VIM:SendMouseMoveEvent(pos.X, pos.Y, game)
                            end
                        end)
                    end
                else
                    if Logging and Logging.new then 
                        Logging.new("shield-lock", "Anti-AFK wyłączony", 3) 
                    end
                    if antiAfkThread then
                        task.cancel(antiAfkThread)
                        antiAfkThread = nil
                    end
                end
            end
        })
        AntiAfkLabel:ToolTip("Symuluje ruch myszką co 60 sekund, aby nie zostać wyrzuconym z gry za bezczynność.")

        local AntiAfkOpt = AntiAfkLabel:AddOption()
        AntiAfkOpt:AddLabel('Interwał'):AddSlider({
            Min = 10, Max = 300, Default = 60, Rounding = 0,
            Flag = "AntiAFKInterval_Player",
            Callback = function(v)
                if antiAfkEnabled then
                    if antiAfkThread then
                        task.cancel(antiAfkThread)
                        antiAfkThread = nil
                    end
                    antiAfkThread = task.spawn(function()
                        while antiAfkEnabled do
                            task.wait(v)
                            local UIS = game:GetService("UserInputService")
                            local VIM = game:GetService("VirtualInputManager")
                            local pos = UIS:GetMouseLocation()
                            VIM:SendMouseMoveEvent(pos.X + 2, pos.Y + 2, game)
                            task.wait(0.05)
                            VIM:SendMouseMoveEvent(pos.X, pos.Y, game)
                        end
                    end)
                end
            end
        })
    end

    -- ----------------------------------------
    --  2. INVISIBILITY
    -- ----------------------------------------
    do
        local UserInputService = game:GetService("UserInputService")
        local RunService       = game:GetService("RunService")
        local Players          = game:GetService("Players")
        local LocalPlayer      = Players.LocalPlayer

        local state = {
            enabled = false,
            key = Enum.KeyCode.Return,
            savedPos = nil,
            savedCamCFrame = nil,
            savedCamType = nil,
            camConnection = nil,
            tpConnection = nil,
            focusPart = nil,
            toggleUI = nil,
            HOTKEY_NAME = "Niewidzialność",
            HOTKEY_ICON = "eye-slash",
        }

        -- === HELPER: konwersja klucza na string (identyczna jak w Fly) ===
        local function keyToString(k)
            if typeof(k) == "EnumItem" then return k.Name end
            local s = tostring(k)
            s = s:gsub("Enum.KeyCode.", "")
            s = s:gsub("Enum.UserInputType.", "")
            return s
        end

        -- === HELPER: parsowanie klawisza ===
        local function parseKey(keyData)
            if typeof(keyData) == "EnumItem" then return keyData end
            if type(keyData) == "string" then
                local cleanName = keyData:match("([^%.]+)$") or keyData
                return Enum.KeyCode[cleanName] or Enum.UserInputType[cleanName]
            elseif type(keyData) == "table" then
                local raw = keyData.Key or keyData.Value or keyData.Code or keyData.Binding or keyData[1]
                if raw then return parseKey(raw) end
            end
            return nil
        end

        -- === HELPER: aktualizacja hotkeya w HUD (identyczna jak w Fly) ===
        local function updateInvisHotkey(enabled, key)
            local HUD = getgenv().MuminekHotkeys
            if not HUD then return end

            if enabled then
                HUD:RemoveHotkey(state.HOTKEY_NAME)
                HUD:AddHotkey({
                    Name = state.HOTKEY_NAME,
                    Icon = state.HOTKEY_ICON,
                    Key  = keyToString(key or state.key),
                    Bold = true,
                })
            else
                HUD:RemoveHotkey(state.HOTKEY_NAME)
            end
        end

        -- === HELPER: aktualizacja samego klawisza w HUD ===
        local function updateInvisBind(newKey)
            local HUD = getgenv().MuminekHotkeys
            if not HUD then return end
            HUD:UpdateKey(state.HOTKEY_NAME, keyToString(newKey))
        end

        -- === HELPER: synchronizacja toggle UI ===
        local function syncToggleUI(val)
            local t = state.toggleUI
            if not t then return end
            pcall(function() if t.Set then t:Set(val) end end)
            pcall(function() if t.SetState then t:SetState(val) end end)
            pcall(function() if t.SetValue then t:SetValue(val) end end)
            pcall(function() if t.Update then t:Update(val) end end)
        end

        -- === WYŁĄCZENIE NIEWIDZIALNOŚCI ===
        local function disableInvisibility()
            pcall(function()
                game:GetService("GuiService"):SetGameplayPausedNotificationEnabled(true)
            end)

            if state.tpConnection then
                state.tpConnection:Disconnect()
                state.tpConnection = nil
            end

            if state.camConnection then
                state.camConnection:Disconnect()
                state.camConnection = nil
            end

            LocalPlayer.ReplicationFocus = nil
            if state.focusPart then
                state.focusPart:Destroy()
                state.focusPart = nil
            end

            local char = LocalPlayer.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.Anchored = false
                    pcall(function()
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end)
                    if state.savedPos then
                        hrp.CFrame = state.savedPos
                    end
                end
            end

            task.defer(function()
                local cam = workspace.CurrentCamera
                if state.savedCamType then
                    cam.CameraType = state.savedCamType
                else
                    cam.CameraType = Enum.CameraType.Custom
                end
                if char and char:FindFirstChildOfClass("Humanoid") then
                    cam.CameraSubject = char:FindFirstChildOfClass("Humanoid")
                end
            end)

            state.savedPos = nil
            state.savedCamCFrame = nil
            state.savedCamType = nil

            if Logging and Logging.new then
                Logging.new("person", "Niewidzialność WYŁĄCZONA – powrót na pozycję", 3)
            end
        end

        -- === WŁĄCZENIE NIEWIDZIALNOŚCI ===
        local function enableInvisibility()
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            pcall(function()
                game:GetService("GuiService"):SetGameplayPausedNotificationEnabled(false)
            end)

            state.savedPos = hrp.CFrame
            local cam = workspace.CurrentCamera
            state.savedCamCFrame = cam.CFrame
            state.savedCamType = cam.CameraType

            local focus = Instance.new("Part")
            focus.Name = "InvisReplicationFocus"
            focus.Anchored = true
            focus.CanCollide = false
            focus.Transparency = 1
            focus.Size = Vector3.new(1, 1, 1)
            focus.CFrame = state.savedCamCFrame
            focus.Parent = workspace

            state.focusPart = focus
            LocalPlayer.ReplicationFocus = focus

            if state.camConnection then state.camConnection:Disconnect() end
            state.camConnection = RunService.RenderStepped:Connect(function()
                if state.enabled and state.savedCamCFrame then
                    cam.CameraType = Enum.CameraType.Scriptable
                    cam.CFrame = state.savedCamCFrame
                end
            end)

            local targetCFrame = state.savedPos + Vector3.new(0, 5000, 0)
            hrp.Anchored = false

            task.spawn(function()
                repeat
                    if not state.enabled then break end
                    local currentChar = LocalPlayer.Character
                    local currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
                    if currentHrp then
                        currentHrp.CFrame = targetCFrame
                        pcall(function()
                            currentHrp.AssemblyLinearVelocity = Vector3.zero
                            currentHrp.AssemblyAngularVelocity = Vector3.zero
                        end)
                    end
                    task.wait(0.03)
                until not state.enabled or (hrp and hrp.Parent and (hrp.Position - targetCFrame.Position).Magnitude < 100)

                if state.enabled and Logging and Logging.new then
                    Logging.new("person", "Teleportacja potwierdzona, Postać jest na +5000 Y", 3)
                end
            end)

            if state.tpConnection then state.tpConnection:Disconnect() end
            state.tpConnection = RunService.Heartbeat:Connect(function()
                if state.enabled and hrp and hrp.Parent then
                    hrp.CFrame = targetCFrame
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end)

            if Logging and Logging.new then
                Logging.new("person", "Niewidzialność włączona", 3)
            end
        end

        -- === TOGGLE ===
        local function toggleInvisibility(forcedState)
            local newState = (forcedState ~= nil) and forcedState or not state.enabled
            if state.enabled == newState then return end
            state.enabled = newState
            syncToggleUI(newState)

            -- INTEGRACJA Z HOTKEYS – identyczna jak w Fly
            updateInvisHotkey(newState, state.key)

            if newState then
                enableInvisibility()
            else
                disableInvisibility()
            end
        end

        -- === UI ===
        local InvisLabel = PlayerSection:AddLabel('Niewidzialność')
        state.toggleUI = InvisLabel:AddToggle({
            Default = false,
            Flag = "InvisibilityToggle_Player",
            Callback = function(v)
                if state.enabled ~= v then
                    toggleInvisibility(v)
                end
            end
        })

        local InvisOpt = InvisLabel:AddOption()
        InvisOpt:AddLabel('Bind'):AddKeybind({
            Default = Enum.KeyCode.Return,
            Flag = "InvisibilityBind_Player",
            Callback = function(key)
                if key == nil or type(key) == "boolean" then
                    toggleInvisibility()
                    return
                end
                local newKey = parseKey(key)
                if newKey then
                    state.key = newKey
                    -- AKTUALIZACJA BINDU W HUD (identyczna jak w Fly)
                    updateInvisBind(newKey)
                end
            end
        })

        -- === NASŁUCHIWANIE KLAWISZA ===
        UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe or UserInputService:GetFocusedTextBox() then return end
            if state.key and (input.KeyCode == state.key or input.UserInputType == state.key) then
                toggleInvisibility()
            end
        end)

        -- === RESET PO RESPAWNIE ===
        LocalPlayer.CharacterAdded:Connect(function()
            if state.enabled then
                toggleInvisibility(false)
            end
        end)
    end

    -- ----------------------------------------
    --  3. AUTO-CLICKER (LPM) + HOTKEYS HUD
    -- ----------------------------------------
    do
        --  DEKLARACJE USŁUG
        local UserInputService = game:GetService("UserInputService")
        local VIM = game:GetService("VirtualInputManager")

        local clickerEnabled = false
        local clickDelay = 0.05
        local clickThread = nil
        local clickerKey = Enum.KeyCode.Z            -- ← NOWY BIND
        local HOTKEY_CLICKER = "Auto-Clicker"        -- ← NAZWA HOTKEYA

        --  HELPER: konwersja klucza na string
        local function keyToString(k)
            if typeof(k) == "EnumItem" then return k.Name end
            return tostring(k)
        end

        --  HELPER: aktualizacja hotkeya w HUD
        local function updateClickerHotkey(enabled, key)
            if not _G.MuminekHotkeys then return end
            local keyName = keyToString(key or clickerKey)
            if enabled then
                _G.MuminekHotkeys:AddHotkey({
                    Name = HOTKEY_CLICKER,
                    Icon = "mouse-button-left",
                    Key = keyName,
                    Bold = true,
                })
            else
                _G.MuminekHotkeys:RemoveHotkey(HOTKEY_CLICKER)
            end
        end

        --  Funkcja sterująca klikerem
        local function startClicker()
            if clickThread then return end
            clickThread = task.spawn(function()
                while clickerEnabled do
                    VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    task.wait(clickDelay)
                    VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                    task.wait(clickDelay)
                end
            end)
        end

        local function stopClicker()
            if clickThread then
                task.cancel(clickThread)
                clickThread = nil
            end
        end

        --  Główny toggle
        local ClickLabel = PlayerSection:AddLabel('Auto-Clicker (LPM)')
        local ClickerToggle = ClickLabel:AddToggle({
            Default = false,
            Flag = "AutoClicker_Player",
            Callback = function(v)
                clickerEnabled = v

                -- INTEGRACJA Z HOTKEYS
                updateClickerHotkey(v, clickerKey)

                if v then
                    if Logging and Logging.new then Logging.new("mouse-button-left", "Auto-Clicker włączony", 3) end
                    startClicker()
                else
                    if Logging and Logging.new then Logging.new("mouse-button-left", "Auto-Clicker wyłączony", 3) end
                    stopClicker()
                end
            end
        })

        local ClickOpt = ClickLabel:AddOption()
        ClickOpt:AddLabel('Opóźnienie (ms)'):AddSlider({
            Min = 10, Max = 500, Default = 50, Rounding = 0,
            Flag = "ClickDelay_Player",
            Callback = function(v)
                clickDelay = v / 1000
                if clickerEnabled and clickThread then
                    stopClicker()
                    startClicker()
                end
            end
        })

        --  Bind (domyślnie Z)
        ClickOpt:AddLabel('Bind'):AddKeybind({
            Default = Enum.KeyCode.Z,
            Flag = "AutoClicker_Bind",
            Callback = function(key)
                local newKey = nil
                if typeof(key) == "EnumItem" then
                    newKey = key
                elseif type(key) == "string" then
                    newKey = Enum.KeyCode[key] or Enum.UserInputType[key]
                end
                if newKey then
                    clickerKey = newKey
                    -- AKTUALIZACJA BINDU W HUD
                    if _G.MuminekHotkeys and clickerEnabled then
                        _G.MuminekHotkeys:UpdateKey(HOTKEY_CLICKER, keyToString(newKey))
                    end
                end
            end
        })

        --  Nasłuch globalny binda (Z przełącza Auto-Clicker)
        UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if UserInputService:GetFocusedTextBox() then return end
            if input.KeyCode == clickerKey or input.UserInputType == clickerKey then
                clickerEnabled = not clickerEnabled

                -- Synchronizacja toggle'a w menu
                pcall(function()
                    if ClickerToggle.SetValue then ClickerToggle:SetValue(clickerEnabled)
                    elseif ClickerToggle.Set then ClickerToggle:Set(clickerEnabled) end
                end)

                -- INTEGRACJA Z HOTKEYS
                updateClickerHotkey(clickerEnabled, clickerKey)

                if clickerEnabled then
                    if Logging and Logging.new then Logging.new("mouse-button-left", "Auto-Clicker ON", 2) end
                    startClicker()
                else
                    if Logging and Logging.new then Logging.new("mouse-button-left", "Auto-Clicker OFF", 2) end
                    stopClicker()
                end
            end
        end)
    end

    -- ----------------------------------------
    --  4. AUTO-TELEPORT PO STRACIE HP
    -- ----------------------------------------
    do
        local autoTpEnabled = false
        local savedPosition = nil
        local hpThreshold = 30
        local isTeleporting = false

        local MainLabel = PlayerSection:AddLabel('Auto-Teleport (HP)')
        MainLabel:AddToggle({
            Default = false,
            Flag = "AutoTeleportHP_Player",
            Callback = function(v)
                autoTpEnabled = v
                if v then
                    local char = game.Players.LocalPlayer.Character
                    if char then
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            savedPosition = hrp.Position
                            if Logging and Logging.new then
                                Logging.new("location-pin", "Zapisano pozycję startową", 3)
                            end
                        end
                    end
                    if Logging and Logging.new then
                        Logging.new("heart", "Auto-Teleport włączony (próg: " .. hpThreshold .. "% HP)", 3)
                    end
                else
                    savedPosition = nil
                    if Logging and Logging.new then
                        Logging.new("heart", "Auto-Teleport wyłączony", 3)
                    end
                end
            end
        })

        local Opt = MainLabel:AddOption()
        Opt:AddLabel('Próg HP (%)'):AddSlider({
            Min = 5, Max = 80, Default = 30, Rounding = 0,
            Flag = "HPThreshold_Player",
            Callback = function(v)
                hpThreshold = v
                if Logging and Logging.new then
                    Logging.new("slider", "Ustawiono próg HP na " .. v .. "%", 3)
                end
            end
        })

        Opt:AddButton({
            Name = "Zapisz obecną pozycję",
            Callback = function()
                local char = game.Players.LocalPlayer.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        savedPosition = hrp.Position
                        if Logging and Logging.new then
                            Logging.new("location-pin", "Zapisano nową pozycję", 3)
                        end
                    end
                else
                    if Logging and Logging.new then
                        Logging.new("triangle-exclamation", "Nie znaleziono postaci!", 3)
                    end
                end
            end
        })

        Opt:AddButton({
            Name = "Teleport do zapisanej pozycji",
            Callback = function()
                if savedPosition then
                    local char = game.Players.LocalPlayer.Character
                    if char then
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            hrp.CFrame = CFrame.new(savedPosition + Vector3.new(0, 2, 0))
                            if Logging and Logging.new then
                                Logging.new("location-pin", "Teleportowano do zapisanej pozycji", 3)
                            end
                        end
                    end
                else
                    if Logging and Logging.new then
                        Logging.new("triangle-exclamation", "Brak zapisanej pozycji!", 3)
                    end
                end
            end
        })

        game:GetService("RunService").Heartbeat:Connect(function()
            if not autoTpEnabled then return end
            if isTeleporting then return end
            if not savedPosition then return end

            local char = game.Players.LocalPlayer.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local healthPercent = (hum.Health / hum.MaxHealth) * 100
            if healthPercent <= hpThreshold then
                isTeleporting = true
                hrp.CFrame = CFrame.new(savedPosition + Vector3.new(0, 2, 0))
                if Logging and Logging.new then
                    Logging.new("heart", "Auto-Teleport! HP: " .. math.floor(healthPercent) .. "% < " .. hpThreshold .. "%", 3)
                end
                task.wait(1)
                isTeleporting = false
            end
        end)
    end

    -- ----------------------------------------
    --  6.             CLICK TP 
    -- ----------------------------------------
    do
        local enabled = false
        local clickButton = Enum.UserInputType.MouseButton2

        local ClickLabel = PlayerSection:AddLabel('Click TP')
        ClickLabel:AddToggle({
            Default = false,
            Flag = "ClickTP_Player",
            Callback = function(v)
                enabled = v
            end
        })

        local ClickOpt = ClickLabel:AddOption()
        ClickOpt:AddLabel('Przycisk myszy'):AddDropdown({
            Default = "Prawy",
            Values = {"Prawy", "Lewy", "Środkowy"},
            Flag = "ClickTP_Button_Player",
            Callback = function(v)
                if v == "Prawy" then
                    clickButton = Enum.UserInputType.MouseButton2
                elseif v == "Lewy" then
                    clickButton = Enum.UserInputType.MouseButton1
                else
                    clickButton = Enum.UserInputType.MouseButton3
                end
            end
        })

        local UIS = game:GetService("UserInputService")
        UIS.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if not enabled then return end
            if input.UserInputType ~= clickButton then return end

            local mousePos = UIS:GetMouseLocation()
            local camera = workspace.CurrentCamera
            if not camera then return end

            local ray = camera:ScreenPointToRay(mousePos.X, mousePos.Y)
            local params = RaycastParams.new()
            local character = game.Players.LocalPlayer.Character
            if character then
                params.FilterDescendantsInstances = {character}
                params.FilterType = Enum.RaycastFilterType.Blacklist
            end

            local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
            if hit then
                if character then
                    local hrp = character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.CFrame = CFrame.new(hit.Position + Vector3.new(0, 3, 0))
                    end
                end
            end
        end)
    end

    if Logging and Logging.new then
        Logging.new("person", "Sekcja Player w Utility załadowana", 3)
    end

    -- ----------------------------------------
    --  5. FULL BRIGHT
    -- ----------------------------------------
    do
        local brightEnabled = false
        local savedFog = {}

        local BrightLabel = PlayerSection:AddLabel('Full Bright')
        BrightLabel:AddToggle({
            Default = false,
            Flag = "FullBright_Player",
            Callback = function(v)
                brightEnabled = v
                local Lighting = game:GetService("Lighting")
                if v then
                    if Logging and Logging.new then Logging.new("sun", "Full Bright ON", 3) end
                    savedFog.FogEnd = Lighting.FogEnd
                    savedFog.FogStart = Lighting.FogStart
                    savedFog.Ambient = Lighting.Ambient
                    savedFog.OutdoorAmbient = Lighting.OutdoorAmbient

                    Lighting.FogEnd = 1000000
                    Lighting.FogStart = 0
                    Lighting.Ambient = Color3.fromRGB(255, 255, 255)
                    Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
                    Lighting.Brightness = 5
                else
                    if Logging and Logging.new then Logging.new("sun", "Full Bright OFF", 3) end
                    Lighting.FogEnd = savedFog.FogEnd or 1000
                    Lighting.FogStart = savedFog.FogStart or 0
                    Lighting.Ambient = savedFog.Ambient or Color3.fromRGB(0,0,0)
                    Lighting.OutdoorAmbient = savedFog.OutdoorAmbient or Color3.fromRGB(0,0,0)
                    Lighting.Brightness = 2
                end
            end
        })
    end

    -- ----------------------------------------
    --  7. FIX CAMERA (reset kamery)
    -- ----------------------------------------
    do
        PlayerSection:AddLabel('Fix Camera')

        PlayerSection:AddButton({
            Name = "Fix Camera",
            Callback = function()
                local cam = workspace.CurrentCamera
                local char = game.Players.LocalPlayer.Character
                if not cam then return end

                -- Reset CameraType do Custom
                pcall(function() cam.CameraType = Enum.CameraType.Custom end)

                -- Reset CameraSubject do Humanoid
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        pcall(function() cam.CameraSubject = hum end)
                    end
                end

                -- Reset FOV do domyślnego
                pcall(function() cam.FieldOfView = 70 end)

                -- Reset CameraOffset
                pcall(function() cam.CameraOffset = Vector3.zero end)

                -- Odblokuj mysz
                pcall(function()
                    game:GetService("UserInputService").MouseBehavior = Enum.MouseBehavior.Default
                end)

                -- Odłącz ewentualny Scriptable lock
                pcall(function()
                    game:GetService("UserInputService").MouseIconEnabled = true
                end)

                if Logging and Logging.new then
                    Logging.new("camera-small", "Kamera zresetowana", 3)
                end
                if getgenv().MuminekToggleNotifier then
                    getgenv().MuminekToggleNotifier:Show("Camera fixed", true)
                end
            end
        })


    end

-- Wolne

end

