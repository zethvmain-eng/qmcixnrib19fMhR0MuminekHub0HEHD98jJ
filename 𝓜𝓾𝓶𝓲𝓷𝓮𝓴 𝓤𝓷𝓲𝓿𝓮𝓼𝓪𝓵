        localDot.BorderSizePixel = 0
        localDot.ZIndex = 50

        local localCorner = Instance.new("UICorner")
        localCorner.CornerRadius = UDim.new(1, 0)
        localCorner.Parent = localDot

        local pulseRing = Instance.new("Frame")
        pulseRing.Name = "PulseRing"
        pulseRing.Parent = localDot
        pulseRing.AnchorPoint = Vector2.new(0.5, 0.5)
        pulseRing.Position = UDim2.new(0.5, 0, 0.5, 0)
        pulseRing.Size = UDim2.new(1, 0, 1, 0)
        pulseRing.BackgroundTransparency = 1
        pulseRing.ZIndex = 49

        local pulseCorner = Instance.new("UICorner")
        pulseCorner.CornerRadius = UDim.new(1, 0)
        pulseCorner.Parent = pulseRing

        local pulseStroke = Instance.new("UIStroke")
        pulseStroke.Color = CONFIG.LocalDotColor
        pulseStroke.Thickness = 1.5
        pulseStroke.Transparency = 0.3
        pulseStroke.Parent = pulseRing

        task.spawn(function()
            while pulseRing and pulseRing.Parent do
                for i = 0, 1, 0.05 do
                    if not pulseRing.Parent then break end
                    local scale = 1 + i * 1.5
                    pulseRing.Size = UDim2.new(scale, 0, scale, 0)
                    pulseStroke.Transparency = 0.3 + i * 0.7
                    task.wait(0.03)
                end
                task.wait(0.2)
            end
        end)

        local playerDots = {}

        local function createPlayerDot(player)
            local container = Instance.new("Frame")
            container.Name = "Dot_" .. player.Name
            container.Parent = DotContainer
            container.AnchorPoint = Vector2.new(0.5, 0.5)
            container.Size = UDim2.new(0, CONFIG.DotSize, 0, CONFIG.DotSize)
            container.BackgroundColor3 = CONFIG.PlayerDotColor
            container.BorderSizePixel = 0
            container.ZIndex = 48
            container.Visible = false

            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(1, 0)
            c.Parent = container

            local dotStroke = Instance.new("UIStroke")
            dotStroke.Color = Color3.fromRGB(0, 0, 0)
            dotStroke.Thickness = 1
            dotStroke.Transparency = 0.5
            dotStroke.Parent = container

            local nameLabel = Instance.new("TextLabel")
            nameLabel.Name = "NameLabel"
            nameLabel.Parent = container
            nameLabel.BackgroundTransparency = 1
            nameLabel.AnchorPoint = Vector2.new(0.5, 1)
            nameLabel.Position = UDim2.new(0.5, 0, 0, -3)
            nameLabel.Size = UDim2.new(0, 80, 0, 12)
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.Text = player.Name
            nameLabel.TextColor3 = CONFIG.PlayerDotColor
            nameLabel.TextSize = 9
            nameLabel.TextStrokeTransparency = 0.4
            nameLabel.TextXAlignment = Enum.TextXAlignment.Center
            nameLabel.ZIndex = 51
            nameLabel.Visible = CONFIG.ShowNames

            return container, nameLabel
        end

        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local dot, label = createPlayerDot(player)
                playerDots[player] = { dot = dot, label = label }
            end
        end

        local playerAddedConn = Players.PlayerAdded:Connect(function(player)
            if player ~= LocalPlayer then
                local dot, label = createPlayerDot(player)
                playerDots[player] = { dot = dot, label = label }
            end
        end)

        local playerRemovingConn = Players.PlayerRemoving:Connect(function(player)
            if playerDots[player] then
                playerDots[player].dot:Destroy()
                playerDots[player] = nil
            end
        end)

        local renderConn = RunService.RenderStepped:Connect(function()
            if not MapFrame or not MapFrame.Parent then return end

            local myChar = LocalPlayer.Character
            if not myChar then return end
            local myHrp = myChar:FindFirstChild("HumanoidRootPart")
            if not myHrp then return end

            local myPos = myHrp.Position
            local cam = workspace.CurrentCamera
            if not cam then return end

            local camLook = cam.CFrame.LookVector
            local camRight = cam.CFrame.RightVector

            local forward = Vector3.new(camLook.X, 0, camLook.Z)
            local right = Vector3.new(camRight.X, 0, camRight.Z)

            if forward.Magnitude < 0.01 then return end
            forward = forward.Unit
            right = right.Unit

            for player, data in pairs(playerDots) do
                local char = player.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local rel = hrp.Position - myPos
                        local dotForward = rel.X * forward.X + rel.Z * forward.Z
                        local dotRight   = rel.X * right.X   + rel.Z * right.Z

                        local scaledX = dotRight / CONFIG.Range
                        local scaledY = dotForward / CONFIG.Range

                        if math.abs(scaledX) > 0.5 or math.abs(scaledY) > 0.5 then
                            data.dot.Visible = false
                        else
                            data.dot.Visible = true
                            data.dot.Position = UDim2.new(0.5 + scaledX, 0, 0.5 - scaledY, 0)
                        end
                    else
                        data.dot.Visible = false
                    end
                else
                    data.dot.Visible = false
                end
            end
        end)

        -- PRZECIĄGANIE z clampowaniem
        local dragging = false
        local dragStart, startPos

        local function clampPosition(newPos)
            local viewportSize = workspace.CurrentCamera.ViewportSize
            local mapSizeX = MapFrame.AbsoluteSize.X
            local mapSizeY = MapFrame.AbsoluteSize.Y

            local x = newPos.X.Offset
            local y = newPos.Y.Offset

            local minX = -(mapSizeX - 40)
            local maxX = viewportSize.X - 40
            local minY = -CONFIG.HeaderHeight
            local maxY = viewportSize.Y - 40

            x = math.clamp(x, minX, maxX)
            y = math.clamp(y, minY, maxY)

            return UDim2.new(0, x, 0, y)
        end

        local headerInputConn = Header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
               or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = MapFrame.Position

                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)

        local inputChangedConn = UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
               or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                local newPos = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
                MapFrame.Position = clampPosition(newPos)
            end
        end)

        -- Funkcja niszcząca (wywoływana przy wyłączeniu toggle)
        _G.__Muminek_DestroyMinimap = function()
            _G.__Muminek_MinimapActive = false

            if renderConn then renderConn:Disconnect() end
            if playerAddedConn then playerAddedConn:Disconnect() end
            if playerRemovingConn then playerRemovingConn:Disconnect() end
            if headerInputConn then headerInputConn:Disconnect() end
            if inputChangedConn then inputChangedConn:Disconnect() end

            if MapFrame then MapFrame:Destroy() end

            playerDots = {}
        end

        if DEBUG_MODE then
            print(" Minimap załadowany (Utility → Hud)")
        end
    end

    -- UI Guzik do Sekcji Hud
    do
        local HudSection = Utility:AddSection({ 
            Name = "Hud", 
            Position = 'right', 
            Icon = "sidebar" 
        })

        -- Minimap
        local MinimapLabel = HudSection:AddLabel('Minimap')
        MinimapLabel:AddToggle({
            Default = false,
            Flag = "Hud_Minimap",
            Callback = function(v)
                if v then
                    if createMinimap then
                        createMinimap()
                        if Logging and Logging.new then
                            Logging.new("location-pin-map", "Minimap włączona", 3)
                        end
                    end
                else
                    if _G.__Muminek_DestroyMinimap then
                        _G.__Muminek_DestroyMinimap()
                        if Logging and Logging.new then
                            Logging.new("location-pin-map", "Minimap wyłączona", 3)
                        end
                    end
                end
            end
        })

        if DEBUG_MODE and Logging and Logging.new then
            Logging.new("sidebar", "Sekcja Hud załadowana", 5)
        end
    end

end

