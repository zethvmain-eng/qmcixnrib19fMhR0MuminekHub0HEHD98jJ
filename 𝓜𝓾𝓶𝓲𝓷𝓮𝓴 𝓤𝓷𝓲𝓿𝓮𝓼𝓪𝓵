do
    local afkLoggerEnabled = false
    local afkThreshold = 60 -- domyślnie 60 sekund
    local afkTimers = {} -- przechowuje czas ostatniego ruchu dla każdego gracza
    local afkNotified = {} -- czy już wysłano powiadomienie dla danego gracza

