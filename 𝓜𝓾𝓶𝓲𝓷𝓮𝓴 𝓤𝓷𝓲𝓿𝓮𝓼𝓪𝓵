            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local angle = 0
            local currentCFrame = hrp.CFrame

            if spinMode == "Continuous" then
                angle = math.rad(spinSpeed * dt)
                lastAngle = lastAngle + angle
            elseif spinMode == "Jitter" then
                jitterTimer = jitterTimer + dt
                local jitterPhase = math.sin(jitterTimer * 10) * 0.5 + 0.5
                local jitterSpeed = spinSpeed * (0.3 + jitterPhase * 0.7)
                angle = math.rad(jitterSpeed * dt)
                lastAngle = lastAngle + angle
            elseif spinMode == "Snap" then
                lastSnapTime = lastSnapTime + dt
                if lastSnapTime >= 0.5 then
                    lastSnapTime = 0
                    angle = math.rad(90)
                    lastAngle = lastAngle + angle
                else
                    angle = 0
                end
            end

            local rotX = (spinAxis:find("X")) and angle or 0
            local rotY = (spinAxis:find("Y")) and angle or 0
            local rotZ = (spinAxis:find("Z")) and angle or 0

            if rotX ~= 0 or rotY ~= 0 or rotZ ~= 0 then
                hrp.CFrame = currentCFrame * CFrame.Angles(rotX, rotY, rotZ)
            end

            local head = char:FindFirstChild("Head")
            if head and spinAxis ~= "Y" then
                head.CFrame = CFrame.new(head.Position, head.Position + hrp.CFrame.LookVector)
            end
        end)

