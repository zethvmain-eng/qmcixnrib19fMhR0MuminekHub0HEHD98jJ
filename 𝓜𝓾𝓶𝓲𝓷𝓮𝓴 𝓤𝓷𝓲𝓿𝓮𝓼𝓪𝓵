                startAiming()
                if Logging and Logging.new then
                    Logging.new("crosshairs", "Legit Bot: celowanie", 2)
                end
            end
        end)

        UIS.InputEnded:Connect(function(input, gpe)
            if not settings.enabled then return end
            if input.UserInputType == settings.aimKey or input.KeyCode == settings.aimKey then
                isAiming = false
                if fovCircle then fovCircle.Visible = false end
                stopAiming()
                if Logging and Logging.new then
                    Logging.new("crosshairs", "Legit Bot: zatrzymano", 2)
                end
            end
        end)

        -- UI
        local LegitLabel = HVHSection:AddLabel('Legit Bot')
        LegitLabel:AddToggle({
            Default = false,
