            if ok and descendants then
                local counter = 0
                for _, obj in pairs(descendants) do
                    counter = counter + 1
                    if counter % 500 == 0 then task.wait() end -- Co 500 obiektów – task.wait() żeby nie zamrozić gry
                    if IGNORED_CLASSES[obj.ClassName] then continue end -- Pomin znane klasy Roblox

                    -- Sprawdź tylko skrypty i ich dzieci
                    local isScript = obj:IsA("Script") or obj:IsA("ModuleScript") or obj:IsA("LocalScript")
                    local parentIsScript = obj.Parent and (obj.Parent:IsA("Script") or obj.Parent:IsA("ModuleScript") or obj.Parent:IsA("LocalScript"))

                    if not isScript and not parentIsScript then continue end

                    local objName = string.lower(tostring(obj.Name))
                    local nameDetected = false

                    -- 1. Sprawdź NAZWĘ
                    for _, keyword in pairs(SUSPICIOUS_KEYWORDS) do
                        if string.find(objName, keyword, 1, true) then
                            table.insert(detected, obj:GetFullName() .. " [name: " .. obj.ClassName .. "]")
                            nameDetected = true
                            break
                        end
                    end

                    -- 2. Sprawdź TREŚĆ (source) – tylko jeśli mamy dostęp
                    if not nameDetected and (obj:IsA("Script") or obj:IsA("ModuleScript")) then
                        local okSource, source = pcall(function() return obj.Source end)
                        if okSource and source and #source > 0 then
                            local src = string.lower(source)
                            for _, keyword in pairs(SOURCE_KEYWORDS) do
                                if string.find(src, keyword, 1, true) then
                                    table.insert(detected, obj:GetFullName() .. " [source: " .. keyword .. "]")
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end

        return detected
    end

    -- WĄTEK GŁÓWNY
    task.spawn(function()
        while true do
            task.wait(0.05)

            if CustomWatermark then CustomWatermark:SetRender(true) end
            if AntiCheat then
                AntiCheat:SetColor('Purple')
                AntiCheat:SetText("Scanning")
            end

            -- Etap 1: Reading (14s) ===
            task.wait(14)

            if CustomWatermark then CustomWatermark:SetRender(false) end
            if AntiCheat then
                AntiCheat:SetColor('Cyan')
                AntiCheat:SetText("Reading")
            end

            -- Etap 2: Skanowanie (skanowanie projektu)
            local detected = ScanForAntiCheat()

            -- Jesli Wykryto AntiCheat
            if #detected > 0 then
                if AntiCheat then
                    AntiCheat:SetColor('Red')
                    AntiCheat:SetText("Detected")
                end

                if Logging and Logging.new then
                    Logging.new("triangle-exclamation", "Wykryto AntiCheat! (" .. #detected .. " obiektów)", 5)
                end

                if Notification and Notification.new then
                    local preview = ""
                    for i = 1, math.min(3, #detected) do
                        preview = preview .. "\n" .. detected[i]
                    end
                    Notification.new({
                        Title = "AntiCheat Wykryty!",
                        Content = "Znaleziono " .. #detected .. " podejrzanych obiektów:" .. preview,
                        Duration = 8,
                    })
                end

                -- Pokaż listę w konsoli
                print("=== ANTI-CHEAT DETECTED ===")
                for i, obj in ipairs(detected) do
                    print("  [" .. i .. "] " .. obj)
                end
                print("===========================")

                -- Zatrzymaj na chwilę w stanie "Detected"
                task.wait(20)
            else
                -- Etap 3: Bypassowanie (20s)
                task.wait(20)

                if CustomWatermark then CustomWatermark:SetRender(false) end
                if AntiCheat then
                    AntiCheat:SetColor('Orange')
                    AntiCheat:SetText("Bypassing")
                end

                -- Etap 4: Bezpieczny (30s)
                task.wait(30)
                if CustomWatermark then CustomWatermark:SetRender(true) end
                if AntiCheat then
                    AntiCheat:SetColor('Green')
                    AntiCheat:SetText("Safe")
                end

                task.wait(5)
                if CustomWatermark then CustomWatermark:SetRender(false) end
                if AntiCheat then AntiCheat:SetRender(false) end
                task.wait(300)
                if AntiCheat then AntiCheat:SetRender(true) end
            end
        end
    end)

