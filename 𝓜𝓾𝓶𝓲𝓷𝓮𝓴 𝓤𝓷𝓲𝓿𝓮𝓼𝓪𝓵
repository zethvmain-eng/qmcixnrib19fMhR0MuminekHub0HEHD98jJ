do
    local HopSection = Movement:AddSection({ Name = "HVH Hop", Position = "left" })

    local settings = {
        enabled = false,
        speed = 80,
    }

    local bodyVelocity = nil
    local defaultWalkSpeed = 16
    local isInAir = false
    local UIS = game:GetService("UserInputService")
    local RunService = game:GetService("RunService")
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer

    -- === Funkcja aktualizująca stan lotu ===
    local function updateHop()
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        local state = hum:GetState()
        local inAirNow = (state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall)

        if not settings.enabled then
            if bodyVelocity then
                bodyVelocity:Destroy()
                bodyVelocity = nil
            end
            if isInAir then
                hum.WalkSpeed = defaultWalkSpeed
                isInAir = false
            end
            return
        end

        -- Jeśli w powietrzu i nie mamy BodyVelocity
        if inAirNow and not bodyVelocity then
            bodyVelocity = Instance.new("BodyVelocity")
            -- TYLKO OSIE X I Z – Y = 0, żeby grawitacja działała
            bodyVelocity.MaxForce = Vector3.new(9e9, 0, 9e9)
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            bodyVelocity.Parent = hrp
            isInAir = true
            hum.WalkSpeed = 0
        end

        -- Jeśli w powietrzu i mamy BodyVelocity
        if inAirNow and bodyVelocity then
            local cam = workspace.CurrentCamera
            if not cam then return end

            local moveDir = Vector3.new(0, 0, 0)
            if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end

            -- Ustawiamy tylko X i Z, Y zostawiamy (grawitacja)
            if moveDir.Magnitude > 0 then
                moveDir = moveDir.Unit
                bodyVelocity.Velocity = Vector3.new(moveDir.X * settings.speed, 0, moveDir.Z * settings.speed)
            else
                bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            end
        end

        -- Jeśli wylądowaliśmy
        if not inAirNow and bodyVelocity then
            bodyVelocity:Destroy()
            bodyVelocity = nil
            isInAir = false
            hum.WalkSpeed = defaultWalkSpeed
        end
    end

    -- === Pętla sprawdzająca (co 0.05s) ===
    local checkThread = nil
    local function startChecking()
        if checkThread then return end
        checkThread = task.spawn(function()
            while settings.enabled do
                updateHop()
                task.wait(0.05)
            end
            checkThread = nil
        end)
    end

    local function stopChecking()
        if checkThread then
            task.cancel(checkThread)
            checkThread = nil
        end
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = defaultWalkSpeed
            end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                for _, child in pairs(hrp:GetChildren()) do
                    if child:IsA("BodyVelocity") then
                        child:Destroy()
                    end
                end
            end
        end
        if bodyVelocity then
            bodyVelocity:Destroy()
            bodyVelocity = nil
        end
        isInAir = false
    end

    -- === Interfejs UI ===
    local HopLabel = HopSection:AddLabel("HVH Hop")
    HopLabel:AddToggle({
        Default = false,
        Flag = "HVHHop_Toggle",
        Callback = function(v)
            settings.enabled = v
            if v then
                local char = LocalPlayer.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        defaultWalkSpeed = hum.WalkSpeed
                    end
                end
                startChecking()
                if Logging and Logging.new then Logging.new("person", "HVH Hop włączony", 3) end
            else
                stopChecking()
                if Logging and Logging.new then Logging.new("person", "HVH Hop wyłączony", 3) end
            end
        end
    })

    local HopOpt = HopLabel:AddOption()
    HopOpt:AddLabel("Prędkość"):AddSlider({
        Min = 20, Max = 200, Default = 80,
        Flag = "HVHHop_Speed",
        Callback = function(v) settings.speed = v end
    })

    -- === Czyszczenie przy respawnie ===
    LocalPlayer.CharacterAdded:Connect(function()
        if settings.enabled then
            task.wait(0.5)
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    defaultWalkSpeed = hum.WalkSpeed
                end
            end
            stopChecking()
            startChecking()
        end
    end)

    if DEBUG_MODE and Logging and Logging.new then
        Logging.new("person", "HVH Hop załadowany", 5)
    end
end

end


