do

do
    -- Zadeklaruj wszystkie potrzebne usługi raz
    local Lighting = game:GetService("Lighting")
    local RunService = game:GetService("RunService")
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local Camera = workspace.CurrentCamera


    --  1. KOLOROWE EFEKTY

    local ColorSection = Fun:AddSection({ Name = "Kolorowe efekty", Position = 'left' })

    -- 1.1 Tęczowe oświetlenie
    local rainbowLighting = false
    local rainbowSpeed = 1.0
    local rainbowConnection = nil

    local RainbowLabel = ColorSection:AddLabel('Tęczowe oświetlenie')
    RainbowLabel:AddToggle({
        Default = false,
        Flag = "RainbowLighting",
        Callback = function(v)
            rainbowLighting = v
            if v then
                if DEBUG_MODE and Logging and Logging.new then Logging.new("star", "Tęczowe światła ON", 3) end
                if not rainbowConnection then
                    rainbowConnection = RunService.Heartbeat:Connect(function()
                        if not rainbowLighting then
                            rainbowConnection:Disconnect()
                            rainbowConnection = nil
                            return
                        end
                        local hue = (tick() * (0.1 * rainbowSpeed)) % 1
                        local color = Color3.fromHSV(hue, 1, 1)
                        Lighting.Ambient = color
                        Lighting.OutdoorAmbient = color
                        Lighting.ColorShift_Top = color
                        Lighting.ColorShift_Bottom = color
                    end)
                end
            else
                if DEBUG_MODE and Logging and Logging.new then Logging.new("star", "Tęczowe światła OFF", 3) end
                if rainbowConnection then
                    rainbowConnection:Disconnect()
                    rainbowConnection = nil
                end
                Lighting.Ambient = Color3.fromRGB(0,0,0)
                Lighting.OutdoorAmbient = Color3.fromRGB(0,0,0)
                Lighting.ColorShift_Top = Color3.fromRGB(0,0,0)
                Lighting.ColorShift_Bottom = Color3.fromRGB(0,0,0)
            end
        end
    })
    local RainbowOpt = RainbowLabel:AddOption()
    RainbowOpt:AddLabel('Prędkość'):AddSlider({
        Min = 0.1, Max = 5.0, Default = 1.0, Rounding = 1,
        Flag = "RainbowSpeed",
        Callback = function(v) rainbowSpeed = v end
    })

    -- 1.2 Dyskotekowe ciało
    local discoBody = false
    local discoSpeed = 1.0
    local discoConnection = nil

    local DiscoLabel = ColorSection:AddLabel('Dyskotekowe ciało')
    DiscoLabel:AddToggle({
        Default = false,
        Flag = "DiscoBody",
        Callback = function(v)
            discoBody = v
            if v then
                if DEBUG_MODE and Logging and Logging.new then Logging.new("star", "Dyskoteka ON", 3) end
                if not discoConnection then
                    discoConnection = RunService.Heartbeat:Connect(function()
                        if not discoBody then
                            discoConnection:Disconnect()
                            discoConnection = nil
                            return
                        end
                        local char = LocalPlayer.Character
                        if not char then return end
                        local hue = (tick() * (0.2 * discoSpeed)) % 1
                        local color = Color3.fromHSV(hue, 1, 1)
                        for _, part in pairs(char:GetDescendants()) do
                            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                                part.Color = color
                            end
                        end
                    end)
                end
            else
                if DEBUG_MODE and Logging and Logging.new then Logging.new("star", "Dyskoteka OFF", 3) end
                if discoConnection then
                    discoConnection:Disconnect()
                    discoConnection = nil
                end
                local char = LocalPlayer.Character
                if char then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.Color = Color3.fromRGB(255,255,255)
                        end
                    end
                end
            end
        end
    })
    local DiscoOpt = DiscoLabel:AddOption()
    DiscoOpt:AddLabel('Prędkość'):AddSlider({
        Min = 0.2, Max = 5.0, Default = 1.0, Rounding = 1,
        Flag = "DiscoSpeed",
        Callback = function(v) discoSpeed = v end
    })


    --  2. EFEKTY EKRANU

    local ScreenSection = Fun:AddSection({ Name = "Efekty ekranu", Position = 'right' })

    -- 2.1 Trzęsienie ekranu
    local shakeEnabled = false
    local shakeIntensity = 5
    local shakeConnection = nil

    local ShakeLabel = ScreenSection:AddLabel('Trzęsienie ekranu')
    ShakeLabel:AddToggle({
        Default = false,
        Flag = "ScreenShake",
        Callback = function(v)
            shakeEnabled = v
            if v then
                if DEBUG_MODE and Logging and Logging.new then Logging.new("star", "Trzęsienie ON", 3) end
                if not shakeConnection then
                    shakeConnection = RunService.RenderStepped:Connect(function()
                        if not shakeEnabled then
                            shakeConnection:Disconnect()
                            shakeConnection = nil
                            return
                        end
                        local offset = Vector3.new(
                            (math.random() - 0.5) * shakeIntensity * 0.2,
                            (math.random() - 0.5) * shakeIntensity * 0.2,
                            0
                        )
                        Camera.CFrame = Camera.CFrame + offset
                    end)
                end
            else
                if DEBUG_MODE and Logging and Logging.new then Logging.new("star", "Trzęsienie OFF", 3) end
                if shakeConnection then
                    shakeConnection:Disconnect()
                    shakeConnection = nil
                end
            end
        end
    })
    local ShakeOpt = ShakeLabel:AddOption()
    ShakeOpt:AddLabel('Moc'):AddSlider({
        Min = 1, Max = 30, Default = 5, Rounding = 0,
        Flag = "ShakeIntensity",
        Callback = function(v) shakeIntensity = v end
    })

    -- 2.2 Obrót ekranu
    local spinScreenEnabled = false
    local spinScreenSpeed = 30
    local spinScreenConnection = nil
    local spinAngle = 0

    local SpinLabel = ScreenSection:AddLabel('Obrót ekranu')
    SpinLabel:AddToggle({
        Default = false,
        Flag = "SpinScreen",
        Callback = function(v)
            spinScreenEnabled = v
            if v then
                if DEBUG_MODE and Logging and Logging.new then Logging.new("star", "Obrót ekranu ON", 3) end
                if not spinScreenConnection then
                    spinAngle = 0
                    spinScreenConnection = RunService.RenderStepped:Connect(function(dt)
                        if not spinScreenEnabled then
                            spinScreenConnection:Disconnect()
                            spinScreenConnection = nil
                            return
                        end
                        spinAngle = spinAngle + math.rad(spinScreenSpeed * dt)
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position) * CFrame.Angles(0, 0, spinAngle)
                    end)
                end
            else
                if DEBUG_MODE and Logging and Logging.new then Logging.new("star", "Obrót ekranu OFF", 3) end
                if spinScreenConnection then
                    spinScreenConnection:Disconnect()
                    spinScreenConnection = nil
                end
                spinAngle = 0
            end
        end
    })
    local SpinOpt = SpinLabel:AddOption()
    SpinOpt:AddLabel('Prędkość'):AddSlider({
        Min = 5, Max = 200, Default = 30, Rounding = 0,
        Flag = "SpinScreenSpeed",
        Callback = function(v) spinScreenSpeed = v end
    })

    -- ----------------------------------------
    --  3. Trolling
    -- ----------------------------------------

do
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local LocalPlayer = Players.LocalPlayer
    local UserInputService = game:GetService("UserInputService")

    -- Sekcja w Fun (lub Troll)
    local TrollSection = Fun:AddSection({ Name = "Troll", Position = 'left' })
    local BackpackLabel = TrollSection:AddLabel('Backpack')

    local backpackEnabled = false
    local backpackTarget = nil
    local backpackThread = nil

    BackpackLabel:AddToggle({
        Default = false,
        Flag = "BackpackToggle",
        Callback = function(v)
            backpackEnabled = v
            if v then
                if Logging and Logging.new then
                    Logging.new("flame", "Backpack włączony – szukam celu...", 3)
                end
                if not backpackThread then
                    backpackThread = task.spawn(function()
                        while backpackEnabled do
                            task.wait(0.05) -- szybkie odświeżanie
                            local char = LocalPlayer.Character
                            if not char then continue end
                            local hrp = char:FindFirstChild("HumanoidRootPart")
                            if not hrp then continue end
                            local hum = char:FindFirstChildOfClass("Humanoid")
                            if not hum then continue end

                            -- Znajdź najbliższego gracza
                            local target = nil
                            local shortestDist = math.huge
                            for _, player in pairs(Players:GetPlayers()) do
                                if player == LocalPlayer then continue end
                                if not player.Character then continue end
                                local targetHrp = player.Character:FindFirstChild("HumanoidRootPart")
                                if not targetHrp then continue end
                                local dist = (hrp.Position - targetHrp.Position).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    target = player
                                end
                            end

                            if target then
                                local targetChar = target.Character
                                if targetChar then
                                    local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
                                    local targetHead = targetChar:FindFirstChild("Head")
                                    if targetHrp and targetHead then
                                        -- Teleportuj nogi (HumanoidRootPart) na poziom głowy celu
                                        -- ale zachowaj X i Z swojej pozycji, tylko Y zmień na Y głowy celu
                                        local newPos = Vector3.new(
                                            hrp.Position.X,
                                            targetHead.Position.Y - 1.5, -- trochę poniżej głowy
                                            hrp.Position.Z
                                        )
                                        hrp.CFrame = CFrame.new(newPos) * CFrame.Angles(0, hrp.Orientation.Y, 0)

                                        -- Dodatkowo ciągnij do przodu/tyłu (w kierunku celu)
                                        local direction = (targetHrp.Position - hrp.Position).Unit
                                        hrp.CFrame = hrp.CFrame + direction * 2.5
                                    end
                                end
                            end
                        end
                    end)
                end
            else
                if Logging and Logging.new then
                    Logging.new("flame", "Backpack wyłączony", 3)
                end
                if backpackThread then
                    task.cancel(backpackThread)
                    backpackThread = nil
                end
            end
        end
    })

    -- Opcjonalny bind (dla szybkiego przełączania)
    local BackpackOpt = BackpackLabel:AddOption()
    BackpackOpt:AddLabel('Bind'):AddKeybind({
        Default = Enum.KeyCode.B,
        Flag = "BackpackBind",
        Callback = function(key)
            -- tu można dodać obsługę binda, ale na razie zostawiam
        end
    })

    if DEBUG_MODE then
        Logging.new("flame", "Backpack załadowany", 3)
    end
end

    -- ----------------------------------------
    --  4. RÓŻNE
    -- ----------------------------------------

    local OtherSection = Fun:AddSection({ Name = "Różne", Position = 'right' })

    -- 3.1 Losowe teleporty
    local randomTpEnabled = false
    local tpInterval = 5
    local tpThread = nil

    local TpLabel = OtherSection:AddLabel('Losowe teleporty')
    TpLabel:AddToggle({
        Default = false,
        Flag = "RandomTP",
        Callback = function(v)
            randomTpEnabled = v
            if v then
                if DEBUG_MODE and Logging and Logging.new then Logging.new("star", "Teleporty ON", 3) end
                if not tpThread then
                    tpThread = task.spawn(function()
                        while randomTpEnabled do
                            task.wait(tpInterval)
                            local char = LocalPlayer.Character
                            if char then
                                local hrp = char:FindFirstChild("HumanoidRootPart")
                                if hrp then
                                    hrp.CFrame = CFrame.new(math.random(-200,200), 10, math.random(-200,200))
                                end
                            end
                        end
                    end)
                end
            else
                if DEBUG_MODE and Logging and Logging.new then Logging.new("star", "Teleporty OFF", 3) end
                if tpThread then
                    task.cancel(tpThread)
                    tpThread = nil
                end
            end
        end
    })
    local TpOpt = TpLabel:AddOption()
    TpOpt:AddLabel('Interwał'):AddSlider({
        Min = 1, Max = 20, Default = 5, Rounding = 0,
        Flag = "TPInterval",
        Callback = function(v)
            tpInterval = v
            if randomTpEnabled and tpThread then
                task.cancel(tpThread)
                tpThread = nil
                tpThread = task.spawn(function()
                    while randomTpEnabled do
                        task.wait(tpInterval)
                        local char = LocalPlayer.Character
                        if char then
                            local hrp = char:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                hrp.CFrame = CFrame.new(math.random(-200,200), 10, math.random(-200,200))
                            end
                        end
                    end
                end)
            end
        end
    })

    -- 3.2 Wielka głowa
    local bigHeadEnabled = false
    local bigHeadScale = 2.0
    local originalHeadSize = nil

    local HeadLabel = OtherSection:AddLabel('Wielka głowa')
    HeadLabel:AddToggle({
        Default = false,
        Flag = "BigHead",
        Callback = function(v)
            bigHeadEnabled = v
            local char = LocalPlayer.Character
            if not char then return end
            local head = char:FindFirstChild("Head")
            if not head then return end
            if v then
                if DEBUG_MODE and Logging and Logging.new then Logging.new("star", "Wielka głowa ON", 3) end 
                head.Size = originalHeadSize * bigHeadScale
            else
                if DEBUG_MODE and Logging and Logging.new then Logging.new("star", "Wielka głowa OFF", 3) end
                if originalHeadSize then head.Size = originalHeadSize end
            end
        end
    })
    local HeadOpt = HeadLabel:AddOption()
    HeadOpt:AddLabel('Skala głowy'):AddSlider({
        Min = 1.5, Max = 5.0, Default = 2.0, Rounding = 1,
        Flag = "BigHeadScale",
        Callback = function(v)
            bigHeadScale = v
            if bigHeadEnabled then
                local char = LocalPlayer.Character
                if char then
                    local head = char:FindFirstChild("Head")
                    if head and originalHeadSize then
                        head.Size = originalHeadSize * v
                    end
                end
            end
        end
    })
end

