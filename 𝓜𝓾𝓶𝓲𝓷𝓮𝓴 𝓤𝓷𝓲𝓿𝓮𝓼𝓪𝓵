    VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

-- === SILENT AIM – PEŁNA LOGIKA (celowanie + opcjonalny strzał) ===
local function SilentAimLogic()
    if not silentEnabled then return end
    local target = getSilentTarget(silentFOV)
    if not target then return end

    -- Celowanie (zawsze)
    local aimed = aimAtTarget(target)
    if not aimed then return end

    -- Jeśli autoShoot włączone, oddaj strzał z opóźnieniem
    if autoShoot then
        local now = tick() * 1000  -- milisekundy
        if now - lastShootTime >= shootDelay then
            shoot()
            lastShootTime = now
        end
    end
end

