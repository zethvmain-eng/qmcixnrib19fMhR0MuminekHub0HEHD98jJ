-- Funkcja szukająca przeciwnika, który podszedł za blisko
local function getTooCloseEnemy()
    local myCharacter = LocalPlayer.Character
    if not myCharacter then return nil end
    local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local closestEnemy = nil
    local shortestDistance = _G.BackstabDistance

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local oppRoot = player.Character:FindFirstChild("HumanoidRootPart")
            local oppHumanoid = player.Character:FindFirstChildOfClass("Humanoid")
            
            -- Sprawdzamy czy wróg żyje i nie ma osłony spawnu (ForceField)
            if oppRoot and oppHumanoid and oppHumanoid.Health > 0 and not player.Character:FindFirstChildOfClass("ForceField") then
                local distance = (myRoot.Position - oppRoot.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestEnemy = player
                end
            end
        end
    end
    return closestEnemy
end

-- Pętla sprawdzająca dystans przy każdej klatce gry
RunService.Heartbeat:Connect(function()
    if not _G.BackstabEnabled or backstabCooldown then return end

    local myCharacter = LocalPlayer.Character
    if not myCharacter then return end
    local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local target = getTooCloseEnemy()
    if target then
        backstabCooldown = true -- Blokujemy pętlę na czas wykonywania akcji
        
        local enemyRoot = target.Character.HumanoidRootPart
        local camera = workspace.CurrentCamera

        -- 1. TELEPORTACJA: Obliczamy pozycję 3.5 studa dokładnie za plecami przeciwnika
        -- Przesunięcie o (0, 0, 3.5) w lokalnym CFrame wroga zawsze ląduje za jego plecami
        local positionBehind = enemyRoot.CFrame * CFrame.new(0, 0, 3.5)
        
        -- Przenosimy naszą postać i obracamy ją twarzą w stronę wroga
        myRoot.CFrame = CFrame.new(positionBehind.Position, enemyRoot.Position)
        
        -- Mikro-opóźnienie (0.03s) na zsynchronizowanie fizyki przez silnik Robloxa
        task.wait(0.03)

        -- 2. CELOWANIE: Błyskawicznie obracamy kamerę prosto na HumanoidRootPart wroga
        camera.CFrame = CFrame.new(camera.CFrame.Position, enemyRoot.Position)

        -- 3. STRZAŁ: Symulujemy natychmiastowe kliknięcie lewego przycisku myszy (LPM)
        VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)  -- Wciśnięcie
