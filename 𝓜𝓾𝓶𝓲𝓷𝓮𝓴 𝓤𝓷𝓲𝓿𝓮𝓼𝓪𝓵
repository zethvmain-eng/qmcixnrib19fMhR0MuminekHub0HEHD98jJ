do
    local FlyLabel = MovementMain:AddLabel('Fly')
    local isFlying = false
    local flySpeed = 50
    local flyKey = Enum.KeyCode.F
    local HOTKEY_NAME = "Fly"
    local HOTKEY_ICON = "person"

    local flyVelocity, flyGyro, flyConnection

    local function stopFly()
        isFlying = false
        if flyVelocity then flyVelocity:Destroy() flyVelocity = nil end
        if flyGyro then flyGyro:Destroy() flyGyro = nil end
        if flyConnection then flyConnection:Disconnect() flyConnection = nil end

        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
        end
    end

    local function startFly()
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        local hum = char:WaitForChild("Humanoid", 5)
        if not hrp or not hum then return end

        stopFly()
        isFlying = true

        flyVelocity = Instance.new("BodyVelocity")
        flyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        flyVelocity.Velocity = Vector3.new(0, 0, 0)
        flyVelocity.Parent = hrp

        flyGyro = Instance.new("BodyGyro")
        flyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        flyGyro.P = 9e4
        flyGyro.CFrame = hrp.CFrame
        flyGyro.Parent = hrp

        flyConnection = RunService.RenderStepped:Connect(function()
            if not isFlying or not hrp or not hrp.Parent then
                stopFly()
                return
            end

            hum.PlatformStand = true
            local moveDir = Vector3.new(0, 0, 0)
            local cam = workspace.CurrentCamera

            if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end

            if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end
            flyVelocity.Velocity = moveDir * flySpeed
            flyGyro.CFrame = cam.CFrame
        end)
    end

    local FlyToggle = FlyLabel:AddToggle({
        Default = false,
        Flag = "FlyToggle",
        Callback = function(state)
            isFlying = state
            updateHUDHotkey(HOTKEY_NAME, state, HOTKEY_ICON, flyKey)

            if state then
                startFly()
                if Logging and Logging.new then Logging.new("person", "Fly Enabled", 3) end
            else
                stopFly()
                if Logging and Logging.new then Logging.new("person", "Fly Disabled", 3) end
            end
        end
    })

    local FlyOpt = FlyLabel:AddOption()

    FlyOpt:AddLabel('Fly Speed'):AddSlider({
        Min = 10, Max = 300, Default = 50, Rounding = 1,
        Flag = "FlySpeed",
        Callback = function(v) flySpeed = v end
    })

    FlyOpt:AddLabel('Bind'):AddKeybind({
        Default = Enum.KeyCode.F,
        Flag = "FlyBind",
        Callback = function(key)
            local newKey = parseKey(key)
            if newKey then
                flyKey = newKey
                updateHUDBind(HOTKEY_NAME, newKey)
            end
        end
    })

    UIS.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and not UIS:GetFocusedTextBox() then
            if input.KeyCode == flyKey or input.UserInputType == flyKey then
                isFlying = not isFlying
                syncToggleUI(FlyToggle, isFlying)
                updateHUDHotkey(HOTKEY_NAME, isFlying, HOTKEY_ICON, flyKey)

                if isFlying then
                    startFly()
                    if Logging and Logging.new then Logging.new("person", "Fly Enabled", 3) end
                else
                    stopFly()
                    if Logging and Logging.new then Logging.new("person", "Fly Disabled", 3) end
                end
            end
        end
    end)

    LocalPlayer.CharacterAdded:Connect(function()
        if isFlying then
            task.wait(1)
            startFly()
            updateHUDBind(HOTKEY_NAME, flyKey)
        end
    end)
end

