-- ----------------------------------------
--    AIMBOT (zoptymalizowany + Hotkeys HUD)
-- ----------------------------------------
do
    local VIM = game:GetService("VirtualInputManager")
    local UIS = game:GetService("UserInputService")
    local RunService = game:GetService("RunService")
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local Camera = workspace.CurrentCamera

    local CombatSection = Combat:AddSection({ Name = "AimBot", Position = 'left' })

    -- == Konfiguracja == --
    local settings = {
        enabled = false,
        fov = 360,
        maxRange = 2000,
        smooth = 1,
        teamCheck = false,
        aimbotKey = Enum.UserInputType.MouseButton2,
        toggleKey = Enum.KeyCode.CapsLock,
        toggleKeyStr = "CapsLock",
        circleColor = Color3.fromRGB(255, 0, 0),
        circleThickness = 2,
        circleFilled = false,
        circleTransparency = 0.5,
        aimPart = "Head",
        extrapolation = false,
        extrapolationAmount = 0.1,
        visibilityCheck = true,
        targetPriority = "FOV",
        aimLock = false,
        recoilControl = false,
        recoilAmount = 2,
        drawFOV = true,
        useMouseMovement = false,
    }

    -- == Drawing == --
    local FOVCircle = Drawing.new("Circle")
    FOVCircle.Thickness = settings.circleThickness
    FOVCircle.NumSides = 64
    FOVCircle.Visible = false
    FOVCircle.Filled = settings.circleFilled
    FOVCircle.Transparency = settings.circleTransparency

    local SnapLine = Drawing.new("Line")
    SnapLine.Thickness = 1.5
    SnapLine.Visible = false

    local HeadDot = Drawing.new("Circle")
    HeadDot.Thickness = 1
    HeadDot.NumSides = 32
    HeadDot.Radius = 6
    HeadDot.Filled = true
    HeadDot.Visible = false

    local PredictionDot = Drawing.new("Circle")
    PredictionDot.Thickness = 1
    PredictionDot.NumSides = 16
    PredictionDot.Radius = 4
    PredictionDot.Filled = true
    PredictionDot.Color = Color3.fromRGB(255, 255, 0)
    PredictionDot.Visible = false

    -- == Zmienne == --
    local aimbotEnabled = false
    local lockedTarget = nil
    local lockedPart = nil
    local currentTarget = nil
    local mouseBlocked = false
    local toggleUI = nil
    local hotkeyName = "Aimbot"
    local aimConnection = nil

    -- == Cache graczy (odświeżany co 1s) == --
    local PlayerCache = { list = {}, time = 0 }

    -- == Helper: konwersja klucza na string == --
    local function keyToString(k)
        if typeof(k) == "EnumItem" then return k.Name end
        local s = tostring(k)
        s = s:gsub("Enum.KeyCode.", "")
        s = s:gsub("Enum.UserInputType.", "")
        return s
    end

    -- == Synchronizacja toggle w menu == --
    local function syncToggleUI(state)
        if not toggleUI then return end
        pcall(function()
            if toggleUI.SetValue then toggleUI:SetValue(state)
            elseif toggleUI.Set then toggleUI:Set(state)
            elseif toggleUI.SetState then toggleUI:SetState(state) end
        end)
        pcall(function()
            if toggleUI.Flag and MuminekHub.Flags[toggleUI.Flag] then
                MuminekHub.Flags[toggleUI.Flag]:SetValue(state)
            end
        end)
    end

    -- == Synchronizacja Hotkeys HUD == --
    local function syncHotkeyHUD(state)
        local HUD = getgenv().MuminekHotkeys
        if not HUD then return end

        if state then
            HUD:RemoveHotkey(hotkeyName)
            HUD:AddHotkey({
                Name = hotkeyName,
                Icon = "crosshairs",
                Key  = settings.toggleKeyStr,
                Bold = true,
            })
        else
            HUD:RemoveHotkey(hotkeyName)
        end
    end

    local function updateHotkeyBind(newKey)
        local HUD = getgenv().MuminekHotkeys
        if not HUD then return end
        HUD:UpdateKey(hotkeyName, settings.toggleKeyStr)
    end

    -- == Toggle Notifier == --
    local function notify(state)
        if getgenv().MuminekToggleNotifier then
            getgenv().MuminekToggleNotifier:Show("Aimbot toggled " .. (state and "on" or "off"), state)
        end
    end

    -- == Start / Stop pętli == --
    local function startAimLoop()
        if aimConnection then
            aimConnection:Disconnect()
            aimConnection = nil
        end
        aimConnection = RunService.Heartbeat:Connect(function()
            if not aimbotEnabled then return end
            aimLoop()
        end)
    end

    -- == Ustawianie stanu == --
    local function setAimbotState(state)
        if aimbotEnabled == state then return end
        aimbotEnabled = state
        syncToggleUI(state)
        syncHotkeyHUD(state)
        notify(state)
        FOVCircle.Visible = state and settings.drawFOV

        if not state then
            SnapLine.Visible = false
            HeadDot.Visible = false
            PredictionDot.Visible = false
            FOVCircle.Visible = false
            lockedTarget = nil
            lockedPart = nil
            currentTarget = nil
            if aimConnection then
                aimConnection:Disconnect()
                aimConnection = nil
            end
        else
            startAimLoop()
        end
    end

    -- == Pobieranie części ciała == --
    local PartMap = {
        Head = {"Head"},
        Neck = {"Neck", "UpperTorso"},
        UpperTorso = {"UpperTorso"},
        LowerTorso = {"LowerTorso"},
        HumanoidRootPart = {"HumanoidRootPart"},
        LeftArm = {"LeftArm", "Left Arm"},
        RightArm = {"RightArm", "Right Arm"},
        LeftLeg = {"LeftLeg", "Left Leg"},
        RightLeg = {"RightLeg", "Right Leg"},
    }

    local function getAimPart(character)
        if not character then return nil end
        local names = PartMap[settings.aimPart]
        if not names then return character:FindFirstChild("Head") end
        for i = 1, #names do
            local p = character:FindFirstChild(names[i])
            if p then return p end
        end
        return character:FindFirstChild("Head")
    end

    local function getTargetVelocity(targetChar)
        local hrp = targetChar:FindFirstChild("HumanoidRootPart")
        if not hrp then return Vector3.new(0, 0, 0) end
        return hrp.Velocity
    end

    -- == Widoczność == --
    local function isVisible(origin, targetPos, targetChar, myChar)
        if not settings.visibilityCheck then return true end
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {myChar, targetChar}
        params.FilterType = Enum.RaycastFilterType.Blacklist
        params.IgnoreWater = true
        local result = workspace:Raycast(origin, targetPos - origin, params)
        return not result
    end

    -- == Znajdowanie celu == --
    local function findTarget()
        local char = LocalPlayer.Character
        if not char then return nil, nil end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil, nil end

        local cam = workspace.CurrentCamera
        if not cam then return nil, nil end

        -- Cache graczy (co 1s)
        if tick() - PlayerCache.time > 1 then
            PlayerCache.list = Players:GetPlayers()
            PlayerCache.time = tick()
        end

        local screenCenter = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        local lookVec = cam.CFrame.LookVector
        local origin = cam.CFrame.Position
        local myHrpPos = hrp.Position

        -- Precompute próg FOV (bez acos)
        -- FOV: jeśli >= 360° → pełna sfera (żaden filtr)
        local FOVDot
        if settings.fov >= 360 then
            FOVDot = -1  -- dowolny kierunek pasuje
        else
            FOVDot = math.cos(math.rad(settings.fov) * 0.5)
        end

        -- Aim lock fast-path
        if settings.aimLock and lockedTarget then
            local tChar = lockedTarget.Character
            if tChar and tChar:IsDescendantOf(workspace) then
                local aimPart = getAimPart(tChar)
                if aimPart then
                    local hum = tChar:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        if (aimPart.Position - myHrpPos).Magnitude <= settings.maxRange then
                            return lockedTarget, aimPart
                        end
                    end
                end
            end
            lockedTarget = nil
            lockedPart = nil
        end

        local bestTarget, bestPart = nil, nil
        local bestScore = math.huge

        for i = 1, #PlayerCache.list do
            local player = PlayerCache.list[i]
            if player ~= LocalPlayer then
                local skip = false
                if settings.teamCheck and player.Team == LocalPlayer.Team then
                    skip = true
                end
                if not skip then
                    local tChar = player.Character
                    if tChar then
                        local hum = tChar:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then
                            local aimPart = getAimPart(tChar)
                            if aimPart then
                                local rel = aimPart.Position - myHrpPos
                                local dist = rel.Magnitude
                                if dist <= settings.maxRange then
                                    local dirToTarget = (aimPart.Position - origin).Unit
                                    if lookVec:Dot(dirToTarget) >= FOVDot then
                                        if isVisible(origin, aimPart.Position, tChar, char) then
                                            local aimPos = aimPart.Position
                                            if settings.extrapolation then
                                                local vel = getTargetVelocity(tChar)
                                                aimPos = aimPos + vel * settings.extrapolationAmount
                                            end

                                            local score
                                            if settings.targetPriority == "FOV" then
                                                local screenPos = cam:WorldToViewportPoint(aimPos)
                                                score = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude + dist * 0.1
                                            elseif settings.targetPriority == "Distance" then
                                                score = dist
                                            else
                                                score = hum.Health
                                            end

                                            if score < bestScore then
                                                bestScore = score
                                                bestTarget = player
                                                bestPart = aimPart
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        lockedTarget = bestTarget
        lockedPart = bestPart
        return bestTarget, bestPart
    end

    -- == Celowanie == --
    local function performAim(target, aimPart)
        if not target or not aimPart then return end

        local origin = Camera.CFrame.Position
        local targetPos = aimPart.Position

        if settings.extrapolation then
            local tChar = target.Character
            if tChar then
                local vel = getTargetVelocity(tChar)
                targetPos = targetPos + vel * settings.extrapolationAmount
            end
        end

        if settings.useMouseMovement then
            local screenPos = Camera:WorldToViewportPoint(targetPos)
            local mousePos = UIS:GetMouseLocation()
            local deltaX = screenPos.X - mousePos.X
            local deltaY = screenPos.Y - mousePos.Y
            if math.abs(deltaX) > 1 or math.abs(deltaY) > 1 then
                VIM:SendMouseMoveEvent(
                    mousePos.X + deltaX * (1 / settings.smooth),
                    mousePos.Y + deltaY * (1 / settings.smooth),
                    game
                )
            end
        else
            local targetCFrame = CFrame.new(origin, targetPos)
            if settings.smooth <= 1 then
                Camera.CFrame = targetCFrame
            else
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 1 / settings.smooth)
            end
        end
    end

    -- == Recoil Control == --
    local function applyRecoilControl()
        if not settings.recoilControl then return end
        if mouseBlocked then return end
        mouseBlocked = true
        local pos = UIS:GetMouseLocation()
        VIM:SendMouseMoveEvent(pos.X, pos.Y + settings.recoilAmount, game)
        task.wait(0.01)
        mouseBlocked = false
    end

    -- == Główna pętla == --
    function aimLoop()
        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

        -- FOV Circle
        if settings.drawFOV and aimbotEnabled then
            FOVCircle.Position = screenCenter
            -- Bezpieczne skalowanie: 1 stopień ≈ 1px promienia
            FOVCircle.Radius = math.clamp(settings.fov / 2, 30, 1400)
            FOVCircle.Color = settings.circleColor
            FOVCircle.Thickness = settings.circleThickness
            FOVCircle.Filled = settings.circleFilled
            FOVCircle.Transparency = settings.circleTransparency
            FOVCircle.Visible = true
        else
            FOVCircle.Visible = false
        end

        -- Sprawdź klawisz
        local isPressed
        if typeof(settings.aimbotKey) == "EnumItem" and settings.aimbotKey.EnumType == Enum.UserInputType then
            isPressed = UIS:IsMouseButtonPressed(settings.aimbotKey)
        else
            isPressed = UIS:IsKeyDown(settings.aimbotKey)
        end

        if not isPressed then
            SnapLine.Visible = false
            HeadDot.Visible = false
            PredictionDot.Visible = false
            currentTarget = nil
            return
        end

        local target, aimPart = findTarget()
        currentTarget = target

        if target and aimPart then
            local targetPos = aimPart.Position
            if settings.extrapolation and target.Character then
                local vel = getTargetVelocity(target.Character)
                targetPos = targetPos + vel * settings.extrapolationAmount
                local screenPos = Camera:WorldToViewportPoint(targetPos)
                PredictionDot.Position = Vector2.new(screenPos.X, screenPos.Y)
                PredictionDot.Visible = true
            else
                PredictionDot.Visible = false
            end

            local screenPos = Camera:WorldToViewportPoint(targetPos)
            local sPos = Vector2.new(screenPos.X, screenPos.Y)

            SnapLine.From = screenCenter
            SnapLine.To = sPos
            SnapLine.Color = settings.circleColor
            SnapLine.Visible = true

            HeadDot.Position = sPos
            HeadDot.Color = settings.circleColor
            HeadDot.Visible = true

            performAim(target, aimPart)
        else
            SnapLine.Visible = false
            HeadDot.Visible = false
            PredictionDot.Visible = false
        end
    end

    -- == Input handler (połączony) == --
    UIS.InputBegan:Connect(function(input, gpe)
        if gpe then return end

        -- Recoil Control (przed sprawdzeniem focusa)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if settings.recoilControl and aimbotEnabled then
                task.spawn(applyRecoilControl)
            end
        end

        -- Toggle bind
        if not UIS:GetFocusedTextBox() then
            if input.KeyCode == settings.toggleKey or input.UserInputType == settings.toggleKey then
                setAimbotState(not aimbotEnabled)
            end
        end
    end)

    -- ============================================================
    --  INTERFEJS
    -- ============================================================
    local MainLabel = CombatSection:AddLabel('Aimbot')

    local AimbotToggleUI = MainLabel:AddToggle({
        Default = false,
        Flag = "Aimbot",
        Callback = function(v)
            setAimbotState(v)
        end
    })
    toggleUI = AimbotToggleUI

    MainLabel:ToolTip("Namierza celownik na przeciwnika\nStrzelanie: LPM\nTrzymanie klawisza: celowanie")

    local AimbotOptions = MainLabel:AddOption()

    AimbotOptions:AddLabel("Cel"):AddDropdown({
        Default = "Head",
        Values = {"Head", "Neck", "UpperTorso", "LowerTorso", "HumanoidRootPart", "LeftArm", "RightArm", "LeftLeg", "RightLeg"},
        Flag = "Aimbot_AimPart",
        Callback = function(v)
            settings.aimPart = v
            lockedTarget = nil
            lockedPart = nil
        end
    })

    AimbotOptions:AddLabel("Smooth"):AddSlider({
        Min = 1, Max = 30, Default = 1,
        Flag = "Smooth-Aimbot",
        Callback = function(v) settings.smooth = v end
    })

    AimbotOptions:AddLabel("Bind"):AddKeybind({
        Default = Enum.KeyCode.CapsLock,
        Flag = "Aimbot-Bind",
        Callback = function(key)
            settings.toggleKey = key
            settings.toggleKeyStr = keyToString(key)
            updateHotkeyBind(key)
        end
    })

    AimbotOptions:AddLabel("Aim Lock Key"):AddKeybind({
        Default = Enum.UserInputType.MouseButton2,
        Flag = "AimLockKey-Aimbot",
        Callback = function(key) settings.aimbotKey = key end
    })

    AimbotOptions:AddLabel("Visual Color"):AddColorPicker({
        Default = Color3.fromRGB(255, 0, 0),
        Flag = "Visual-Color-Aimbot",
        Callback = function(color)
            settings.circleColor = color
            FOVCircle.Color = color
            SnapLine.Color = color
            HeadDot.Color = color
        end
    })

    AimbotOptions:AddLabel("Ekstrapolacja"):AddToggle({
        Default = false,
        Flag = "Aimbot_Extrapolation",
        Callback = function(v)
            settings.extrapolation = v
            if not v then PredictionDot.Visible = false end
        end
    })

    AimbotOptions:AddLabel("Reakcja"):AddSlider({
        Min = 0.02, Max = 0.5, Default = 0.1, Precision = 2,
        Flag = "Aimbot_ExtrapolationAmount",
        Callback = function(v) settings.extrapolationAmount = v end
    })

    AimbotOptions:AddLabel("Priorytet"):AddDropdown({
        Default = "FOV",
        Values = {"FOV", "Distance", "Health"},
        Flag = "Aimbot_Priority",
        Callback = function(v) settings.targetPriority = v end
    })

    AimbotOptions:AddLabel("Blokada celu"):AddToggle({
        Default = false,
        Flag = "Aimbot_AimLock",
        Callback = function(v)
            settings.aimLock = v
            if not v then lockedTarget = nil; lockedPart = nil end
        end
    })

