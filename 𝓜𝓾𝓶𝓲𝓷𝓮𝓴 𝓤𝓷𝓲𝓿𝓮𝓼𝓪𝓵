    -- Funkcja aktualizująca timer dla gracza (wywoływana przy ruchu)
    local function updatePlayerActivity(player)
        if not player or not player.Character then return end
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        -- Rejestrujemy czas ostatniego ruchu (przy każdej zmianie pozycji)
        -- Użyjemy GetPropertyChangedSignal na Position, ale to może być kosztowne.
        -- Prościej: w pętli sprawdzamy pozycję co jakiś czas.
    end

    -- Główna pętla sprawdzająca AFK
    task.spawn(function()
        while true do
            task.wait(1) -- sprawdzanie co sekundę
            if not afkLoggerEnabled then
                -- reset stanu gdy wyłączone
                afkTimers = {}
                afkNotified = {}
                continue
            end

            local currentTime = os.time()
            for _, player in pairs(Players:GetPlayers()) do
                if player == LocalPlayer then continue end -- pomijamy siebie
                local char = player.Character
                if not char then
                    -- Jeśli gracz nie ma postaci, uznajemy że jest AFK (lub offline)
                    -- Można pominąć lub traktować jako AFK
                    continue
                end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then continue end

                local userId = player.UserId
                -- Inicjalizacja timera jeśli pierwszy raz
                if not afkTimers[userId] then
                    afkTimers[userId] = currentTime
                    afkNotified[userId] = false
                end

                -- Sprawdzenie czy postać się poruszyła (porównanie pozycji z poprzednią)
                -- Używamy prostej metody: przechowujemy ostatnią pozycję
                local lastPos = afkTimers[userId] -- tu przechowujemy czas, ale potrzebujemy też pozycji
                -- Zmieniamy: przechowujemy czas ostatniego ruchu + ostatnią pozycję
            end
        end
    end)

    -- Lepsza implementacja: przechowujemy ostatnią pozycję i czas
    local lastPositions = {}
    local lastMoveTimes = {}

    -- Nasłuch na zmianę pozycji każdego gracza
    Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function(char)
            local hrp = char:WaitForChild("HumanoidRootPart", 5)
            if hrp then
                local userId = player.UserId
                lastPositions[userId] = hrp.Position
                lastMoveTimes[userId] = os.time()
                afkNotified[userId] = false

                hrp:GetPropertyChangedSignal("Position"):Connect(function()
                    if not afkLoggerEnabled then return end
                    local newPos = hrp.Position
                    if (newPos - lastPositions[userId]).Magnitude > 0.5 then -- ruch o ponad 0.5 studa
                        lastPositions[userId] = newPos
                        lastMoveTimes[userId] = os.time()
                        afkNotified[userId] = false
                    end
                end)
            end
        end)
    end)

    -- Obsługa już istniejących graczy
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if player.Character then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local userId = player.UserId
                    lastPositions[userId] = hrp.Position
                    lastMoveTimes[userId] = os.time()
                    afkNotified[userId] = false
                    hrp:GetPropertyChangedSignal("Position"):Connect(function()
                        if not afkLoggerEnabled then return end
                        local newPos = hrp.Position
                        if (newPos - lastPositions[userId]).Magnitude > 0.5 then
                            lastPositions[userId] = newPos
                            lastMoveTimes[userId] = os.time()
                            afkNotified[userId] = false
                        end
                    end)
                end
            end
        end
    end

    -- Główna pętla sprawdzająca AFK i wysyłająca powiadomienia
    task.spawn(function()
        while true do
            task.wait(2) -- sprawdzanie co 2 sekundy
            if not afkLoggerEnabled then
                -- czyścimy stany
                lastPositions = {}
                lastMoveTimes = {}
                afkNotified = {}
                continue
            end

            local currentTime = os.time()
            for _, player in pairs(Players:GetPlayers()) do
                if player == LocalPlayer then continue end
                local userId = player.UserId
                if lastMoveTimes[userId] then
                    local idleTime = currentTime - lastMoveTimes[userId]
                    if idleTime >= afkThreshold and not afkNotified[userId] then
                        -- Gracz jest AFK
                        Notification.new({
                            Title = " " .. player.Name .. " jest AFK",
                            Content = "Bezczynny od " .. idleTime .. " sekund.",
                            Duration = 5,
                        })
