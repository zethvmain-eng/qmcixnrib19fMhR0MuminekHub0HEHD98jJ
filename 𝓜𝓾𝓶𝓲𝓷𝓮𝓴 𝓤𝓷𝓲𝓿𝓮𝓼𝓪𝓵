                        fovCircle.Radius = (v / 180) * (cam.ViewportSize.Y / 2.5)
                    end
                end
            end
        })
        LegitOpt:AddLabel('Smooth'):AddSlider({
            Min = 1, Max = 30, Default = 10,
            Flag = "LegitBot_Smooth",
            Callback = function(v) settings.smooth = v end
        })
        LegitOpt:AddLabel('Opóźnienie (s)'):AddSlider({
            Min = 0.02, Max = 0.5, Default = 0.1, Precision = 2,
            Flag = "LegitBot_Delay",
            Callback = function(v) settings.delay = v end
        })
        LegitOpt:AddLabel('Klawisz'):AddKeybind({
