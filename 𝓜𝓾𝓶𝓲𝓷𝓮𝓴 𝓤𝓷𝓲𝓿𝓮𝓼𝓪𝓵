-- Uniwersalna funkcja parsująca klawisz z dowolnego formatu UI
local function parseKey(keyData)
    if typeof(keyData) == "EnumItem" then
        return keyData
    elseif type(keyData) == "string" then
        local cleanName = keyData:match("([^%.]+)$") or keyData
        return Enum.KeyCode[cleanName] or Enum.UserInputType[cleanName]
    elseif type(keyData) == "table" then
        local raw = keyData.Key or keyData.Value or keyData.Code or keyData.Binding or keyData[1]
        if raw then
            return parseKey(raw)
        end
    end
    return nil
end

-- Uniwersalny synchronizator stanu Toggle dla UI
local function syncToggleUI(toggleObj, state)
    if not toggleObj then return end

    local methods = {"Set", "SetState", "SetValue", "Toggle", "Update", "UpdateToggle", "ChangeState"}
    for _, methodName in ipairs(methods) do
        if type(toggleObj[methodName]) == "function" then
            local success = pcall(function()
                toggleObj[methodName](toggleObj, state)
            end)
            if success then return end
        end
    end

    if type(toggleObj.Toggle) == "table" then
        for _, methodName in ipairs(methods) do
            if type(toggleObj.Toggle[methodName]) == "function" then
                local success = pcall(function()
                    toggleObj.Toggle[methodName](toggleObj.Toggle, state)
                end)
                if success then return end
            end
        end
    end

    pcall(function() toggleObj.Value = state end)
    pcall(function() toggleObj.State = state end)
end

-- Wspólny helper: konwersja klucza na string (obsługa Enum.KeyCode i Enum.UserInputType)
local function keyToString(k)
    if typeof(k) == "EnumItem" then
        return k.Name
    end
    local s = tostring(k)
    s = s:gsub("Enum.KeyCode.", "")
    s = s:gsub("Enum.UserInputType.", "")
    return s
end

-- Wspólny helper: aktualizacja hotkeya w HUD (z ochroną przed duplikatami)
local function updateHUDHotkey(hotkeyName, enabled, icon, key)
    local HUD = getgenv().MuminekHotkeys
    if not HUD then return end

    if enabled then
        HUD:RemoveHotkey(hotkeyName)
        HUD:AddHotkey({
            Name = hotkeyName,
            Icon = icon,
            Key  = keyToString(key),
            Bold = true,
        })
    else
        HUD:RemoveHotkey(hotkeyName)
    end
end

-- Wspólny helper: aktualizacja samego klawisza w HUD
local function updateHUDBind(hotkeyName, newKey)
    local HUD = getgenv().MuminekHotkeys
    if not HUD then return end
    HUD:UpdateKey(hotkeyName, keyToString(newKey))
end

