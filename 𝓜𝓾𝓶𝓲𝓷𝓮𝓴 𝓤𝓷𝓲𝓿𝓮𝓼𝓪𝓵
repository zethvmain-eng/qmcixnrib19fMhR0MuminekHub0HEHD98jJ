        VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0) -- Puszczenie

        -- Opcjonalne powiadomienie w logach Neverlose
        if Logging and Logging.new then
            Logging.new("sword", "Auto-Backstabbed: " .. target.Name, 3)
        end

        -- Cooldown chroniący przed banem za zbyt częste teleporty
        task.wait(cooldownTime)
        backstabCooldown = false
    end
end)

