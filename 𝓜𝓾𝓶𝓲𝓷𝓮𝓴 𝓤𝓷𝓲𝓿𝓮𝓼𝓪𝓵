            if input.KeyCode == spinKey or input.UserInputType == spinKey then
                spinbotEnabled = not spinbotEnabled

                -- Synchronizacja toggle'a w menu
                pcall(function()
                    if SpinbotToggle.SetValue then SpinbotToggle:SetValue(spinbotEnabled)
                    elseif SpinbotToggle.Set then SpinbotToggle:Set(spinbotEnabled) end
                end)

