        --  HELPER: konwersja klucza na string (obsługuje Enum.KeyCode i Enum.UserInputType)
        local function keyToString(k)
            if typeof(k) == "EnumItem" then
                return k.Name
            end
            local s = tostring(k)
            s = s:gsub("Enum.KeyCode.", "")
            s = s:gsub("Enum.UserInputType.", "")
