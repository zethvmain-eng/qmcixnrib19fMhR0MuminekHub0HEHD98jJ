        -- Klient HTTP (działa z większością executorów)
        local rawRequest = (syn and syn.request)
            or (xeno and xeno.request)
            or (http and http.request)
            or http_request
            or request
            or (fluxus and fluxus.request)
            or (krnl and krnl.request)

        if not rawRequest then
            -- Brak wsparcia HTTP – pomiń obecność
            return
        end

        local HttpService = game:GetService("HttpService")
        local Players = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer

        local function request(options)
            local reqData = {
                Url = options.Url,
                Method = options.Method or "GET",
                Headers = options.Headers or {},
                Body = options.Body
            }
            local ok, res = pcall(function() return rawRequest(reqData) end)
            if ok and res then
                return res.Body or res.body or res.Response or res.data
            end
            return nil
        end

        local Presence = {
            ActiveUsers = {},
            LastId = 0,
        }

        -- Powiadomienie – używa ToggleNotifier
        local function notify(text, isOnline)
            local tn = getgenv().MuminekToggleNotifier
            if tn and tn.Show then
                pcall(function() tn:Show(text, isOnline) end)
            end
            if Logging and Logging.new then
                pcall(function()
                    Logging.new(isOnline and "person-plus" or "person-arrow-from-bottom-right", text, 4)
                end)
            end
        end

        -- Wyślij sygnał
        local function sendSignal(kind)
            task.spawn(function()
                pcall(function()
                    request({
                        Url = PRESENCE_URL .. "/send",
                        Method = "POST",
                        Headers = { ["Content-Type"] = "application/json" },
                        Body = HttpService:JSONEncode({
                            senderName = LocalPlayer.Name,
                            userId = LocalPlayer.UserId,
                            text = "__PRESENCE__:" .. kind,
                            isPresence = true,
                            presenceKind = kind
                        })
                    })
                end)
            end)
        end

        -- Start: poinformuj innych że jesteśmy online
        task.delay(2, function()
            sendSignal("join")
        end)

        -- Heartbeat co 10s
        task.spawn(function()
            while task.wait(HEARTBEAT_INTERVAL) do
                sendSignal("heartbeat")
            end
        end)

        -- Poinformuj o wyjściu (client-side)
        -- Roblox nie pozwala BindToClose na kliencie, więc wysyłamy sygnał
        -- gdy LocalPlayer zostanie odłączony od gry (teleport, disconnect)
        pcall(function()
            LocalPlayer.AncestryChanged:Connect(function(_, parent)
                if not parent then
                    sendSignal("leave")
                end
            end)
        end)

        -- Dodatkowo: gdy gracz zostanie teleportowany
        pcall(function()
            LocalPlayer.OnTeleport:Connect(function(state)
                if state == Enum.TeleportState.Started then
                    sendSignal("leave")
                end
            end)
        end)

        -- Polling: sprawdzaj obecność innych co 2s
        task.spawn(function()
            while task.wait(POLL_INTERVAL) do
                local url = PRESENCE_URL .. "/messages?since=" .. tostring(Presence.LastId)
                local body = request({ Url = url, Method = "GET" })

                if body and typeof(body) == "string" and #body > 0 then
                    local ok, msgs = pcall(function() return HttpService:JSONDecode(body) end)
                    if ok and typeof(msgs) == "table" then
                        for _, msg in ipairs(msgs) do
                            local numericId = tonumber(msg.id)
                            if numericId and numericId > Presence.LastId then
                                Presence.LastId = numericId

                                local sender = tostring(msg.senderName or "?")
                                local txt = tostring(msg.text or "")

                                if sender ~= LocalPlayer.Name then
                                    local kind = msg.presenceKind or txt:match("__PRESENCE__:(%w+)")

                                    if kind == "join" then
                                        Presence.ActiveUsers[sender] = tick()
                                        notify(sender .. " jest Online", true)

                                    elseif kind == "heartbeat" then
                                        Presence.ActiveUsers[sender] = tick()

                                    elseif kind == "leave" then
                                        Presence.ActiveUsers[sender] = nil
                                        notify(sender .. " jest Offline", false)
                                    end end end end end end

                -- Timeout – brak heartbeatu przez TIMEOUT_SECONDS = offline
                for user, lastTime in pairs(Presence.ActiveUsers) do
