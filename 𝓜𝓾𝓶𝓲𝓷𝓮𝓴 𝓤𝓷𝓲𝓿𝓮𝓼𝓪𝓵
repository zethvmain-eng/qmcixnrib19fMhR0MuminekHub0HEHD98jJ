            elseif child:IsA("DepthOfFieldEffect") and settings.removeDepthOfField then
                table.insert(effectsToRemove, child)
            elseif child:IsA("Atmosphere") and settings.removeAtmosphere then
                table.insert(effectsToRemove, child)
            elseif child:IsA("Sky") and settings.removeSky then
                table.insert(effectsToRemove, child)
            end
        end
    end

    -- === Funkcja usuwająca efekty ===
