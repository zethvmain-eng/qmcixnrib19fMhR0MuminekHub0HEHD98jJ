    -- === Funkcja sprawdzająca kąt (bez raycasta) ===
    local function isLookingAtMeSimple(headPos, myPos, lookVector)
        local directionToMe = (myPos - headPos).Unit
        local dot = lookVector:Dot(directionToMe)
        return dot > 0.97
    end

    -- === Funkcja z raycastem (WallCheck) ===
    local function isLookingAtMeWithWallCheck(character, headPos, myPos, lookVector, myCharacter)
        if not isLookingAtMeSimple(headPos, myPos, lookVector) then
            return false
        end
        -- Raycast sprawdzający, czy jest przeszkoda między nami
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {character, myCharacter}
        params.FilterType = Enum.RaycastFilterType.Exclude
        local rayResult = workspace:Raycast(headPos, myPos - headPos, params)
        return not rayResult  -- true = brak przeszkody → widzi nas
    end

    -- === Główna funkcja sprawdzająca ===
    local function checkObservation()
        local myChar = LocalPlayer.Character
        if not myChar then return false end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return false end
        local myPos = myRoot.Position

        -- 1. Gracze
        for _, player in pairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            local char = player.Character
            if not char then continue end
            local head = char:FindFirstChild("Head")
            if not head then continue end
            local dist = (head.Position - myPos).Magnitude
            if dist > settings.maxDistance then continue end

            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then continue end

            local lookVec = head.CFrame.LookVector
            if settings.wallCheck then
                if isLookingAtMeWithWallCheck(char, head.Position, myPos, lookVec, myChar) then
                    return true
                end
            else
                if isLookingAtMeSimple(head.Position, myPos, lookVec) then
                    return true
                end
            end
        end

        -- 2. NPC (jeśli włączone)
        if settings.detectNPC then
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
                    local head = obj:FindFirstChild("Head")
                    if not head then continue end
                    local dist = (head.Position - myPos).Magnitude
                    if dist > settings.maxDistance then continue end

                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health <= 0 then continue end

                    local lookVec = head.CFrame.LookVector
                    if settings.wallCheck then
                        if isLookingAtMeWithWallCheck(obj, head.Position, myPos, lookVec, myChar) then
                            return true
                        end
                    else
                        if isLookingAtMeSimple(head.Position, myPos, lookVec) then
                            return true
                        end
                    end
                end
            end
        end

        return false
    end

    -- === Start / Stop ===
    local function startChecking()
        if checkThread then return end
        observerIndicator:SetRender(true)
        observerIndicator:SetColor("Green")
        observerIndicator:SetText("Bezpieczny")
        lastState = false

        checkThread = task.spawn(function()
            while settings.enabled do
                local isWatched = checkObservation()
                if isWatched then
                    observerIndicator:SetColor("Red")
                    observerIndicator:SetText("Obserwowany")
                    if not lastState then
                        lastState = true
                        if Logging and Logging.new then
                            Logging.new("eye", "Jesteś obserwowany!", 3)
                        end
                    end
                else
                    observerIndicator:SetColor("Green")
                    observerIndicator:SetText("Bezpieczny")
                    lastState = false
                end
                task.wait(settings.checkInterval)
            end
            checkThread = nil
        end)
    end

    local function stopChecking()
        if checkThread then
            task.cancel(checkThread)
            checkThread = nil
        end
        lastState = false
        observerIndicator:SetRender(false)
    end

