-- Funkcja sprawdzająca matematycznie, czy przeciwnik patrzy na nas
local function isLookingAtMe(player)
    local character = player.Character
    local myCharacter = LocalPlayer.Character
    if not character or not myCharacter then return false end

    local head = character:FindFirstChild("Head")
    local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
    if not head or not myRoot then return false end

    -- Sprawdzamy, czy przeciwnik w ogóle żyje
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then return false end

    -- Obliczamy kierunek patrzenia wroga względem nas
    local directionToMe = (myRoot.Position - head.Position).Unit
    local lookVector = head.CFrame.LookVector

    -- Iloczyn skalarny (Dot Product) - 1.0 oznacza patrzenie prosto w punkt
    local dot = lookVector:Dot(directionToMe)

    -- 0.97 to bardzo wąski, precyzyjny stożek wzroku (wróg celuje w naszą postać)
    if dot > 0.97 then
        -- Raycast: Sprawdzamy, czy wróg nie patrzy na nas przez ścianę
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {character, myCharacter}
        params.FilterType = Enum.RaycastFilterType.Exclude

        local raycastResult = workspace:Raycast(head.Position, myRoot.Position - head.Position, params)
        if not raycastResult then
            return true -- Brak przeszkód na linii wzroku, wróg nas widzi!
        end
    end
    return false
end

-- Główna pętla sprawdzająca sytuację na mapie przy każdej klatce gry
RunService.Heartbeat:Connect(function()
    if not _G.AntiLookTP then return end
    
    local now = os.clock()
    if now - lastTeleport < cooldown then return end

    local myCharacter = LocalPlayer.Character
    if not myCharacter then return end
    local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isLookingAtMe(player) then
            lastTeleport = now
            
            -- Losujemy kierunek: lewo (-20 studów) lub prawo (20 studów)
            local sideDirection = (math.random(1, 2) == 1 and -20 or 20)
            
            -- Teleportacja lokalna (w boki względem Twojej postaci, a nie mapy)
            myRoot.CFrame = myRoot.CFrame * CFrame.new(sideDirection, 0, 0)
            break
        end
    end
end)

