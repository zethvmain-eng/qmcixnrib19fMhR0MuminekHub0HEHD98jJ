do
    local hideUiSection = Utility:AddSection({ Name = "Hide UI", Position = 'left', Icon = "eye-slash" })

    local hideUiEnabled = false
    local hideUiThread = nil

    -- Funkcja usuwająca/ukrywająca GUI
    local function hideUI()
        if not hideUiEnabled then return end

        -- Szukamy wszystkich ScreenGui w CoreGui i PlayerGui
        local coreGui = game:GetService("CoreGui")
        local playerGui = game.Players.LocalPlayer:WaitForChild("PlayerGui")

        -- Lista wyjątków (nie usuwaj własnego menu ani innych ważnych elementów)
        local exceptions = {
            "MuminekHub",          -- Twoje menu
            "MuminekHUD_System",   -- Twój HUD
            "HealthBar",           -- Przykład
            "Chat",                -- Czat (zazwyczaj nie chcemy usuwać)
            "RobloxGui",           -- Podstawowe GUI Robloxa
        }

        local function shouldIgnore(instance)
            for _, name in ipairs(exceptions) do
                if instance.Name:find(name) then
                    return true
                end
            end
            return false
        end

        -- Przetwarzanie CoreGui
        for _, child in pairs(coreGui:GetChildren()) do
            if not shouldIgnore(child) and child:IsA("ScreenGui") then
                child.Enabled = false
            end
        end

        -- Przetwarzanie PlayerGui
        for _, child in pairs(playerGui:GetChildren()) do
            if not shouldIgnore(child) and child:IsA("ScreenGui") then
                child.Enabled = false
            end
        end
    end

    -- Funkcja przywracająca GUI
    local function restoreUI()
        local coreGui = game:GetService("CoreGui")
        local playerGui = game.Players.LocalPlayer:WaitForChild("PlayerGui")

        -- Przywracamy wszystkie ScreenGui (oprócz wyjątków, które i tak nie były wyłączone)
        for _, child in pairs(coreGui:GetChildren()) do
            if child:IsA("ScreenGui") then
                child.Enabled = true
            end
        end

        for _, child in pairs(playerGui:GetChildren()) do
            if child:IsA("ScreenGui") then
                child.Enabled = true
            end
        end
    end

    -- Główny przełącznik
    local toggle = hideUiSection:AddLabel('Ukryj UI (przyciski, sklep)')
    toggle:AddToggle({
        Default = false,
        Flag = "HideUI_Utility",
        Callback = function(v)
            hideUiEnabled = v
            if v then
                hideUI()
                if Logging and Logging.new then
                    Logging.new("eye-slash", "UI ukryte", 3)
                end
            else
                restoreUI()
                if Logging and Logging.new then
                    Logging.new("eye-slash", "UI przywrócone", 3)
                end
            end
        end
    })

    -- Opcjonalny przycisk do ręcznego odświeżenia (na wypadek, gdyby coś zostało)
    hideUiSection:AddButton({
        Name = "Odśwież ukrywanie",
        Callback = function()
            if hideUiEnabled then
                hideUI()
                if Logging and Logging.new then
                    Logging.new("eye-slash", "UI ponownie ukryte", 3)
                end
            else
                if Logging and Logging.new then
                    Logging.new("eye-slash", "UI już widoczne", 3)
                end
            end
        end
    })

    -- Nasłuch na dodanie nowych elementów GUI (aby je automatycznie ukryć)
    if not _G._hideUiListener then
        _G._hideUiListener = true
        local coreGui = game:GetService("CoreGui")
        local playerGui = game.Players.LocalPlayer:WaitForChild("PlayerGui")

        local function onNewGui(instance)
            if hideUiEnabled and instance:IsA("ScreenGui") then
                -- Sprawdź, czy to nie jest wyjątek
                local exceptions = {"MuminekHub", "MuminekHUD_System", "RobloxGui"}
                local shouldIgnore = false
                for _, name in ipairs(exceptions) do
                    if instance.Name:find(name) then
                        shouldIgnore = true
                        break
                    end
                end
                if not shouldIgnore then
                    instance.Enabled = false
                end
            end
        end

        coreGui.DescendantAdded:Connect(onNewGui)
        playerGui.DescendantAdded:Connect(onNewGui)
    end

      if DEBUG_MODE and Logging and Logging.new then
        Logging.new("eye-slash", "Moduł Hide UI załadowany", 5)
    end
end

