do

    -- -----------------------------------------------
    --  WAYPOINT – SEKCJA ZAPISU (6 SLOTÓW + CUSTOM NAZWY)
    -- -----------------------------------------------
    do
        local SaveSection = WayPoint:AddSection({ 
            Name = "Zapisz pozycję", 
            Position = 'left',
            Icon = "location-pin"
        })

        -- Wspólna tabela pozycji (dostępna dla obu sekcji)
        _G.WaypointPositions = _G.WaypointPositions or { [1] = nil, [2] = nil, [3] = nil, [4] = nil, [5] = nil, [6] = nil }
        local savedPositions = _G.WaypointPositions

        -- Wspólna tabela nazw slotów – DOMYŚLNIE "Slot 1".."Slot 6" (max 7 znaków)
        _G.WaypointNames = _G.WaypointNames or {
            [1] = "Slot 1",
            [2] = "Slot 2",
            [3] = "Slot 3",
            [4] = "Slot 4",
            [5] = "Slot 5",
            [6] = "Slot 6",
        }
        local slotNames = _G.WaypointNames

        local function getCurrentPosition()
            local char = game.Players.LocalPlayer.Character
            if not char then return nil end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return nil end
            return hrp.Position
        end

        -- Tworzenie 6 slotów
        for i = 1, 6 do
            -- Etykieta slotu
            local slotLabel = SaveSection:AddLabel(slotNames[i] .. "  ")

            -- Pole tekstowe zmiany nazwy (bezpośrednio na etykiecie – handler)
            slotLabel:AddTextInput({
                Default = slotNames[i],
                Placeholder = "Zmień nazwę",
                Flag = "WaypointName_" .. i,
                Size = 100,
                Callback = function(newName)
                    if newName and newName ~= "" and #newName <= 7 then
                        slotNames[i] = newName
                        _G.WaypointNames[i] = newName
                        slotLabel:SetText(newName .. ((savedPositions[i] and "  ⭐") or "  "))
                        if Logging and Logging.new then
                            Logging.new("pencil", "Zmieniono nazwę slotu " .. i .. " na: " .. newName, 3)
                        end
                    elseif newName and #newName > 7 then
                        if Logging and Logging.new then
                            Logging.new("triangle-exclamation", "Nazwa może mieć max 7 znaków!", 3)
                        end
                    end
                end
            })

            -- Przycisk zapisu w opcjach (3 kropki)
            local slotOpt = slotLabel:AddOption()
            slotOpt:AddButton({
                Name = "Zapisz " .. slotNames[i],
                Callback = function()
                    local pos = getCurrentPosition()
                    if pos then
                        savedPositions[i] = pos
                        slotLabel:SetText(slotNames[i] .. "  ⭐")
                        if Logging and Logging.new then
                            Logging.new("location-pin", "Zapisano " .. slotNames[i], 3)
                        end
                    else
                        if Logging and Logging.new then
                            Logging.new("triangle-exclamation", "Nie znaleziono postaci!", 3)
                        end
                    end
                end
            })
        end

        -- Przycisk czyszczenia
        SaveSection:AddButton({
            Icon = 'trash-can',
            Name = "Wyczyść wszystkie sloty",
            Callback = function()
                for i = 1, 6 do
                    savedPositions[i] = nil
                    slotNames[i] = "Slot " .. i
                    _G.WaypointNames[i] = slotNames[i]
                end
                if Logging and Logging.new then
                    Logging.new("trash-can", "Wyczyszczono wszystkie sloty", 3)
                end
            end
        })
    end

    -- -----------------------------------------------
    --  WAYPOINT – SEKCJA TELEPORTU
    -- -----------------------------------------------
    do
        local TPSection = WayPoint:AddSection({ 
            Name = "Teleport do slotu", 
            Position = 'right',
            Icon = "location-pin-map"
        })

        -- Używamy tej samej tabeli co w sekcji zapisu
        local savedPositions = _G.WaypointPositions or { [1] = nil, [2] = nil, [3] = nil, [4] = nil, [5] = nil, [6] = nil }
        _G.WaypointPositions = savedPositions

        local slotNames = _G.WaypointNames or {
            [1] = "Slot 1",
            [2] = "Slot 2",
            [3] = "Slot 3",
            [4] = "Slot 4",
            [5] = "Slot 5",
            [6] = "Slot 6",
        }

        local function teleportTo(position)
            if not position then
                if Logging and Logging.new then
                    Logging.new("triangle-exclamation", "Brak zapisanej pozycji!", 3)
                end
                return
            end
            local char = game.Players.LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            hrp.CFrame = CFrame.new(position + Vector3.new(0, 2, 0))
            if Logging and Logging.new then
                Logging.new("location-pin", "Teleportowano!", 3)
            end
        end

        -- Tworzenie 6 przycisków TP
        for i = 1, 6 do
            TPSection:AddButton({
                Name = "TP do " .. slotNames[i],
                Callback = function()
                    if savedPositions[i] then
                        teleportTo(savedPositions[i])
                    else
                        if Logging and Logging.new then
                            Logging.new("triangle-exclamation", " " .. slotNames[i] .. " jest pusty!", 3)
                        end
                    end
                end
            })
        end
    end

end

