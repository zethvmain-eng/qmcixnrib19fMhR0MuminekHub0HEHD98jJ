        -- ============================================
        local function getPlayer(nameStr)
            if not nameStr or nameStr == "" then return nil end
            nameStr = nameStr:lower()
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name:lower():sub(1, #nameStr) == nameStr or p.DisplayName:lower():sub(1, #nameStr) == nameStr then
                    return p
                end
            end
            return nil
        end
    
        -- ============================================
        --  KOMENDY
        -- ============================================
        local function executeCommand(cmdStr)
            local args = {}
            for word in cmdStr:gmatch("%S+") do
                table.insert(args, word)
            end
            if #args == 0 then return end
    
            local cmd = args[1]:lower()
            local targetArg = args[2]
            local extraArg = args[3]
    
            local isMe = false
            if targetArg then
                local tLower = targetArg:lower()
                if tLower == "all" or tLower == "me" or tLower == LocalPlayer.Name:lower() or tLower == LocalPlayer.DisplayName:lower() then
                    isMe = true
                else
                    local p = getPlayer(targetArg)
                    if p == LocalPlayer then isMe = true end
                end
            end
    
            -- POMOC
            if cmd == "/help" then
                createMessageBubble("SYSTEM", 0, table.concat({
                    "═══ DOSTĘPNE KOMENDY ═══",
                    "",
                    "▸ GRACZ",
                    "/freeze [gracz] - zamraża",
                    "/unfreeze [gracz] - rozmraża",
                    "/kill [gracz] - zabija",
                    "/kick [gracz] [powód] - wyrzuca (self)",
                    "/follow [gracz] - podąża za graczem",
                    "/unfollow - zatrzymuje podążanie",
                    "",
                    "▸ CZAT",
                    "/say [gracz] [tekst] - pisze jako gracz",
                    "/pm [gracz] [tekst] - DM (tag w treści)",
                    "/spam [ile] [tekst] - spamuje (max 20)",
                    "/clearchat - czyści czat",
                    "",
                    "▸ POSTAĆ (self)",
                    "/speed [liczba] - prędkość",
                    "/jump [liczba] - moc skoku",
                    "/fly - latanie",
                    "/nofly - wyłącza latanie",
                    "/noclip - przenikanie ścian",
                    "/invisible - niewidzialność",
                    "/visible - przywraca widoczność",
                    "/heal - pełne HP",
                    "/reset - reset postaci",
                    "",
                    "▸ TELEPORT",
                    "/tp [gracz] - teleport do gracza",
                    "/tppos [x] [y] [z] - teleport do pozycji",
                    "",
                    "▸ INFO",
                    "/who - lista graczy",
                    "/ping - twój ping",
                    "/pos - twoja pozycja",
                    "/copy [tekst] - kopiuje do schowka",
                }, "\n"), false, true)
    
            -- GRACZ
            elseif cmd == "/freeze" then
                if isMe then
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        char.HumanoidRootPart.Anchored = true
                        createMessageBubble("SYSTEM", 0, "Zamrożono: " .. LocalPlayer.Name, false, true)
                    end
                end
            elseif cmd == "/unfreeze" then
                if isMe then
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        char.HumanoidRootPart.Anchored = false
                        createMessageBubble("SYSTEM", 0, "Rozmrożono: " .. LocalPlayer.Name, false, true)
                    end
                end
            elseif cmd == "/kill" then
                if isMe then
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChildOfClass("Humanoid") then
                        char:FindFirstChildOfClass("Humanoid").Health = 0
                        createMessageBubble("SYSTEM", 0, "Zabito: " .. LocalPlayer.Name, false, true)
                    end
                end
            elseif cmd == "/kick" then
                if isMe then
                    LocalPlayer:Kick(extraArg or "Wyrzucony komendą /kick")
                end
            elseif cmd == "/follow" then
                if isMe then
                    if currentFollowTask then task.cancel(currentFollowTask) currentFollowTask = nil end
                    local followTarget = getPlayer(extraArg)
                    if followTarget and followTarget.Character then
                        createMessageBubble("SYSTEM", 0, "Podążanie za: " .. followTarget.Name, false, true)
                        currentFollowTask = task.spawn(function()
                            while followTarget and followTarget.Character and followTarget.Character:FindFirstChild("HumanoidRootPart") do
                                local char = LocalPlayer.Character
                                if char and char:FindFirstChildOfClass("Humanoid") then
                                    char:FindFirstChildOfClass("Humanoid"):MoveTo(followTarget.Character.HumanoidRootPart.Position)
                                end
                                task.wait(0.3)
                            end
                        end)
                    end
                end
            elseif cmd == "/unfollow" or cmd == "/stopfollow" then
                if currentFollowTask then
                    task.cancel(currentFollowTask)
                    currentFollowTask = nil
                    createMessageBubble("SYSTEM", 0, "Zatrzymano podążanie.", false, true)
                end
    
            -- CZAT
            elseif cmd == "/say" then
                if not targetArg or not extraArg then
                    createMessageBubble("SYSTEM", 0, "Użycie: /say [gracz] [tekst]", false, true)
                    return
                end
    
                local textParts = {}
                for i = 3, #args do table.insert(textParts, args[i]) end
                local sayText = table.concat(textParts, " ")
    
                if sayText == "" then
                    createMessageBubble("SYSTEM", 0, "Podaj treść.", false, true)
                    return
                end
    
                local targetPlayer = getPlayer(targetArg)
                local spoofName = targetPlayer and targetPlayer.Name or targetArg
                local spoofUserId = targetPlayer and targetPlayer.UserId or 0
    
                local msgKey = spoofName .. ":" .. sayText
                sentLocalMsgs[msgKey] = true
                createMessageBubble(spoofName, spoofUserId, sayText, false, false)
    
                task.spawn(function()
                    safeHttpRequest({
                        Url = SERVER_URL .. "/send",
                        Method = "POST",
                        Headers = { ["Content-Type"] = "application/json" },
                        Body = HttpService:JSONEncode({
                            senderName = spoofName,
                            userId = spoofUserId,
                            text = sayText,
                            spoofed = true,
                            spoofedBy = LocalPlayer.Name
                        })
                    })
                end)
    
            elseif cmd == "/pm" then
                if not targetArg or not extraArg then
                    createMessageBubble("SYSTEM", 0, "Użycie: /pm [gracz] [tekst]", false, true)
                    return
                end
    
                local textParts = {}
                for i = 3, #args do table.insert(textParts, args[i]) end
                local pmText = table.concat(textParts, " ")
    
                local targetPlayer = getPlayer(targetArg)
                if not targetPlayer then
                    createMessageBubble("SYSTEM", 0, "Gracz nie znaleziony.", false, true)
                    return
                end
    
                local dmText = "[DM → " .. targetPlayer.Name .. "] " .. pmText
                createMessageBubble(LocalPlayer.Name, LocalPlayer.UserId, dmText, true, false)
    
                task.spawn(function()
                    safeHttpRequest({
                        Url = SERVER_URL .. "/send",
                        Method = "POST",
                        Headers = { ["Content-Type"] = "application/json" },
                        Body = HttpService:JSONEncode({
                            senderName = LocalPlayer.Name,
                            userId = LocalPlayer.UserId,
                            text = dmText,
                            isDM = true,
                            dmTarget = targetPlayer.Name
                        })
                    })
                end)
    
            elseif cmd == "/spam" then
local count = tonumber(targetArg) or 5
                local textParts = {}
                for i = 3, #args do table.insert(textParts, args[i]) end
                local spamText = table.concat(textParts, " ")
    
                if spamText == "" then
                    createMessageBubble("SYSTEM", 0, "Użycie: /spam [ile] [tekst]", false, true)
                    return
                end
    
                count = math.clamp(count, 1, 20)
                createMessageBubble("SYSTEM", 0, "Spamuję " .. count .. "x", false, true)
    
                task.spawn(function()
                    for i = 1, count do
                        createMessageBubble(LocalPlayer.Name, LocalPlayer.UserId, spamText, true, false)
                        safeHttpRequest({
                            Url = SERVER_URL .. "/send",
                            Method = "POST",
                            Headers = { ["Content-Type"] = "application/json" },
                            Body = HttpService:JSONEncode({
                                senderName = LocalPlayer.Name,
                                userId = LocalPlayer.UserId,
                                text = spamText
                            })
                        })
                        task.wait(0.4)
                    end
                end)
    
            elseif cmd == "/clearchat" then
                for _, child in ipairs(ScrollFrame:GetChildren()) do
                    if child:IsA("Frame") then child:Destroy() end
                end
                playSound(4590662766, 1)
                createMessageBubble("SYSTEM", 0, "Czat wyczyszczony.", false, true)
    
            -- POSTAĆ
            elseif cmd == "/speed" then
                if isMe then
                    local speed = tonumber(extraArg) or tonumber(targetArg) or 16
                    speed = math.clamp(speed, 1, 500)
                    local char = LocalPlayer.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.WalkSpeed = speed
                        createMessageBubble("SYSTEM", 0, "WalkSpeed: " .. speed, false, true)
                    end
                end
            elseif cmd == "/jump" then
                if isMe then
                    local power = tonumber(extraArg) or tonumber(targetArg) or 50
                    power = math.clamp(power, 1, 500)
                    local char = LocalPlayer.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.UseJumpPower = true
                        hum.JumpPower = power
                        createMessageBubble("SYSTEM", 0, "JumpPower: " .. power, false, true)
                    end
                end
            elseif cmd == "/fly" then
                if isMe then
                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if hrp and not hrp:FindFirstChild("MuminekFlyVelocity") then
                        local bv = Instance.new("BodyVelocity")
                        bv.Name = "MuminekFlyVelocity"
                        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                        bv.Velocity = Vector3.zero
                        bv.Parent = hrp
    
                        local bg = Instance.new("BodyGyro")
                        bg.Name = "MuminekFlyGyro"
                        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                        bg.P = 9e4
                        bg.CFrame = hrp.CFrame
                        bg.Parent = hrp
    
                        createMessageBubble("SYSTEM", 0, "Fly ON – /nofly aby wyłączyć", false, true)
                    end
                end
            elseif cmd == "/nofly" then
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local bv = hrp:FindFirstChild("MuminekFlyVelocity")
                    local bg = hrp:FindFirstChild("MuminekFlyGyro")
                    if bv then bv:Destroy() end
                    if bg then bg:Destroy() end
                    createMessageBubble("SYSTEM", 0, "Fly OFF", false, true)
                end
            elseif cmd == "/noclip" then
                if isMe then
                    local char = LocalPlayer.Character
                    if char then
                        for _, part in ipairs(char:GetDescendants()) do
                            if part:IsA("BasePart") then part.CanCollide = false end
                        end
                        createMessageBubble("SYSTEM", 0, "Noclip ON", false, true)
                    end
                end
            elseif cmd == "/invisible" then
                if isMe then
                    local char = LocalPlayer.Character
                    if char then
                        for _, part in ipairs(char:GetDescendants()) do
                            if part:IsA("BasePart") then part.Transparency = 1
                            elseif part:IsA("Decal") then part.Transparency = 1 end
                        end
                        createMessageBubble("SYSTEM", 0, "Invisible ON", false, true)
                    end
                end
            elseif cmd == "/visible" then
                if isMe then
                    local char = LocalPlayer.Character
                    if char then
                        for _, part in ipairs(char:GetDescendants()) do
                            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then part.Transparency = 0
                            elseif part:IsA("Decal") then part.Transparency = 0 end
                        end
                        createMessageBubble("SYSTEM", 0, "Visible ON", false, true)
                    end
                end
            elseif cmd == "/heal" then
                if isMe then
                    local char = LocalPlayer.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.Health = hum.MaxHealth
                        createMessageBubble("SYSTEM", 0, "Uleczono", false, true)
                    end
                end
            elseif cmd == "/reset" then
                if isMe then
                    LocalPlayer:LoadCharacter()
                    createMessageBubble("SYSTEM", 0, "Reset postaci", false, true)
                end
    
            -- TELEPORT
            elseif cmd == "/tp" then
                local tpTarget = getPlayer(targetArg)
                if not tpTarget then
                    createMessageBubble("SYSTEM", 0, "Gracz nie znaleziony", false, true)
                    return
                end
                local myChar = LocalPlayer.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local tChar = tpTarget.Character
                local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
                if myHrp and tHrp then
                    myHrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, 3)
                    createMessageBubble("SYSTEM", 0, "Teleport do: " .. tpTarget.Name, false, true)
                end
    
            elseif cmd == "/tppos" then
                local x = tonumber(targetArg)
                local y = tonumber(extraArg)
                local z = tonumber(args[4])
                if not x or not y or not z then
                    createMessageBubble("SYSTEM", 0, "Użycie: /tppos [x] [y] [z]", false, true)
                    return
                end
                local myChar = LocalPlayer.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if myHrp then
                    myHrp.CFrame = CFrame.new(x, y, z)
                    createMessageBubble("SYSTEM", 0, "Teleport do pozycji", false, true)
                end
    
            -- INFO
            elseif cmd == "/who" then
                local playerList = {}
                for _, p in ipairs(Players:GetPlayers()) do
                    table.insert(playerList, "• " .. p.Name .. " - ID: " .. p.UserId)
                end
                createMessageBubble("SYSTEM", 0, "Gracze (" .. #playerList .. "):\n" .. table.concat(playerList, "\n"), false, true)
    
            elseif cmd == "/ping" then
                local ping = math.floor(LocalPlayer:GetNetworkPing() * 1000)
                createMessageBubble("SYSTEM", 0, "Ping: " .. ping .. " ms", false, true)
    
            elseif cmd == "/pos" then
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local p = hrp.Position
                    createMessageBubble("SYSTEM", 0, string.format("X=%.1f Y=%.1f Z=%.1f", p.X, p.Y, p.Z), false, true)
                end
    
            elseif cmd == "/copy" then
                local textParts = {}
                for i = 2, #args do table.insert(textParts, args[i]) end
                local copyText = table.concat(textParts, " ")
                if copyText ~= "" then
                    copyToClipboard(copyText)
                    showToast("Skopiowano!")
                end
    
            else
                createMessageBubble("SYSTEM", 0, "Nieznana komenda: " .. cmd .. " (wpisz /help)", false, true)
            end
        end
    
        -- ============================================
        --  SEND MESSAGE
        -- ============================================
        local function sendMessage()
            local text = InputBox.Text
            if text:gsub("%s+", "") == "" then return end
            InputBox.Text = ""
    
            if text:sub(1,1) == "/" then
                executeCommand(text)
                task.spawn(function()
                    safeHttpRequest({
                        Url = SERVER_URL .. "/send",
                        Method = "POST",
                        Headers = { ["Content-Type"] = "application/json" },
                        Body = HttpService:JSONEncode({
                            senderName = LocalPlayer.Name,
                            userId = LocalPlayer.UserId,
                            text = text
                        })
                    })
                end)
                return
            end
    
            local msgKey = LocalPlayer.Name .. ":" .. text
            sentLocalMsgs[msgKey] = true
            createMessageBubble(LocalPlayer.Name, LocalPlayer.UserId, text, true, false)
    
            task.spawn(function()
                safeHttpRequest({
                    Url = SERVER_URL .. "/send",
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = HttpService:JSONEncode({
                        senderName = LocalPlayer.Name,
                        userId = LocalPlayer.UserId,
                        text = text
                    })
                })
            end)
        end
    
        SendBtn.MouseButton1Click:Connect(sendMessage)
        InputBox.FocusLost:Connect(function(enter) if enter then sendMessage() end end)
    
        -- ============================================
        --  POLLING WIADOMOŚCI Z SERWERA
        -- ============================================
        task.spawn(function()
            if not rawRequest then return end
            while task.wait(1) do
                local fetchUrl = SERVER_URL .. "/messages?since=" .. tostring(lastMsgId)
                local responseBody = safeHttpRequest({ Url = fetchUrl, Method = "GET" })
                if responseBody and typeof(responseBody) == "string" and #responseBody > 0 then
                    local decodeOk, msgs = pcall(function() return HttpService:JSONDecode(responseBody) end)
                    if decodeOk and typeof(msgs) == "table" then
                        for _, msg in ipairs(msgs) do
                            local numericId = tonumber(msg.id)
                            if numericId and numericId > lastMsgId then
                                lastMsgId = numericId
                                local msgText = tostring(msg.text or "")
                                local msgKey = tostring(msg.senderName) .. ":" .. msgText
                                if not sentLocalMsgs[msgKey] then
                                    if msgText:sub(1,1) == "/" then
                                        executeCommand(msgText)
                                    else
                                        local isSelf = (msg.senderName == LocalPlayer.Name)
                                        createMessageBubble(msg.senderName, msg.userId, msgText, isSelf, false)
                                    end
                                else
                                    sentLocalMsgs[msgKey] = nil
                                end
                            end
                        end
                    end
                end
            end
        end)
    
