	local Previous = ModernV2._ActiveTweens[Self];
	if Previous then
		pcall(function() Previous:Cancel(); end);
	end;
	local Tween = TweenService:Create(Self , Info or TweenInfo.new(0.25) , Property);

	Tween:Play();
	ModernV2._ActiveTweens[Self] = Tween;  -- [OPT-H2] track active tween per instance

