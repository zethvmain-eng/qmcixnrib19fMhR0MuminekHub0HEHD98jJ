	local disconnect;

	local LastActiveState;  -- [OPT-H4] cache to skip redundant wake-ups when state unchanged
	local UpdateFunction = function()
		local IsWindowActive = Signal:GetValue();
		if IsWindowActive == LastActiveState then return false; end;  -- [OPT-H4] no-op when state unchanged
		LastActiveState = IsWindowActive;

		if IsWindowActive and not ModernV2.Global3DRenderMode then

			ModernV2.PlayAnimate(DepthOfField,TweenInfo.new(0.1),{
				NearIntensity = 1
			})

			ModernV2.PlayAnimate(Part,TweenInfo.new(0.1),{
