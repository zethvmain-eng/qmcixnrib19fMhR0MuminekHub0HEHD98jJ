			if typeof(source) ~= "table" then
				return Map;
			end;

			for key,value in next, source do
				if typeof(key) == "number" then
					Map[tostring(value)] = true;
				elseif value == true then
					Map[tostring(key)] = true;
				end;
			end;

			return Map;
		end;

