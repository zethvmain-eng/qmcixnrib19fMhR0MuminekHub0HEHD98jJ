		-- Saves {Enabled, SelectedConfig} to <ConfigFolder>/autoload.json
		-- so that on script restart, the user's last-selected config
		-- can be auto-loaded instead of the hardcoded "Default".
		function ConfigLib:WriteAutoLoadState(enabled, configName)
			pcall(function()
				if not isfolder(Window.ConfigFolder) then
					makefolder(Window.ConfigFolder);
				end;
				local data = {
					Enabled = enabled == true,
					SelectedConfig = tostring(configName or ConfigLib.SelectedConfig or "Default");
				};
				writefile(Window.ConfigFolder .. '/autoload.json', HttpService:JSONEncode(data));
			end);
		end;
		
		-- Read {Enabled, SelectedConfig} from <ConfigFolder>/autoload.json.
		-- Returns nil if the file is missing, unreadable, or invalid JSON.
		function ConfigLib:ReadAutoLoadState()
			local path = Window.ConfigFolder .. '/autoload.json';
			if not isfile(path) then
				return nil;
			end;
			local ok, decoded = pcall(function()
				return HttpService:JSONDecode(readfile(path));
			end);
			if not ok or type(decoded) ~= "table" then
				return nil;
			end;
			return decoded;
		end;

