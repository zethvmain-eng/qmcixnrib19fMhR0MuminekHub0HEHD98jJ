		});

		local Holder = Instance.new("Frame")
		Holder.Name = ModernV2.RandomString();
		Holder.Parent = Frame
		Holder.BackgroundTransparency = 1
		Holder.BorderSizePixel = 0
		Holder.Size = UDim2.new(1, 0, 0, 30)
		Holder.ZIndex = LayerIndex + 8

