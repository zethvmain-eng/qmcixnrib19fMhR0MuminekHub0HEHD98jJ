		-- Auto-build SubButton langsung dari Config.SubName (tanpa perlu chaining)
		if Config.SubName then
			Button:AddButton({
				Name = Config.SubName,
				Icon = Config.SubIcon,
				IconPosition = Config.SubIconPosition,
				Tags = Config.SubTags,
				Callback = Config.SubCallback,
